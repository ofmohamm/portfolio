---
// A black panther lounging on a branch. Original drawing for the site.
// viewBox units: the branch's top surface is y=132, and (165, 132) is the
// anchor that sits on the limb. Mood is set by html[data-mood]:
//   sleepy  eyes shut, slow breathing, z's; wakes up on hover
//   curious eyes open, slow blinks, pupils follow the cursor
---
<svg class="panther" viewBox="0 0 300 210" role="img" aria-label="A black panther napping on a branch">
  <g class="pan">
    <!-- tail, hanging over the far side of the branch -->
    <path class="tail" d="M246 122 C 270 130, 274 160, 263 182 C 257 195, 268 204, 281 195" fill="none" stroke="#1C1D1A" stroke-width="12" stroke-linecap="round" />

    <!-- back leg, dangling -->
    <path d="M208 126 C 206 148, 210 166, 214 178 C 217 189, 235 188, 234 177 C 232 162, 232 146, 237 126 Z" fill="#1C1D1A" />
    <path d="M215 182 q 4 3 8 0 M222 183 q 4 3 8 0" fill="none" stroke="#33352F" stroke-width="1.4" stroke-linecap="round" />

    <!-- body: breathes -->
    <g class="breath">
      <path d="M104 134 C 100 104, 136 86, 176 86 C 214 86, 252 94, 254 120 C 255 134, 244 139, 228 139 L 112 139 C 106 139, 104 137, 104 134 Z" fill="#1C1D1A" />
      <circle cx="226" cy="112" r="27" fill="#1C1D1A" />
      <!-- ghost rosettes: black panthers still carry their spots -->
      <g fill="none" stroke="#2A2C27" stroke-width="2.2">
        <circle cx="146" cy="106" r="4.5" /><circle cx="166" cy="98" r="4" /><circle cx="187" cy="105" r="5" />
        <circle cx="206" cy="97" r="4" /><circle cx="160" cy="121" r="4.5" /><circle cx="182" cy="124" r="4" />
        <circle cx="222" cy="122" r="5" /><circle cx="236" cy="104" r="4" /><circle cx="130" cy="120" r="3.5" />
      </g>
      <path d="M124 99 Q 176 80 238 95" fill="none" stroke="#3B3D37" stroke-width="3" stroke-linecap="round" opacity=".8" />
    </g>

    <!-- front leg, dangling -->
    <path d="M106 128 C 101 150, 97 166, 96 177 C 95 188, 112 190, 113 180 C 115 165, 119 149, 127 132 Z" fill="#1C1D1A" />
    <path d="M99 184 q 4 3 8 0" fill="none" stroke="#33352F" stroke-width="1.4" stroke-linecap="round" />

    <!-- paw under the chin -->
    <ellipse cx="92" cy="135" rx="18" ry="8.5" fill="#1C1D1A" />
    <path d="M80 138 q 3 2.5 6 0 M87 139 q 3 2.5 6 0" fill="none" stroke="#33352F" stroke-width="1.3" stroke-linecap="round" />

    <!-- head -->
    <g class="head" transform="rotate(-5 72 108)">
      <path class="ear ear-l" d="M42 94 C 35 72, 42 58, 53 60 C 62 62, 67 73, 67 83 Z" fill="#1C1D1A" />
      <path class="ear ear-r" d="M85 80 C 87 67, 96 58, 105 61 C 116 65, 112 85, 105 96 Z" fill="#1C1D1A" />
      <path d="M48 85 C 45 72, 49 66, 54 67 C 59 69, 61 75, 60 81 Z" fill="#3A3B35" />
      <path d="M91 79 C 93 71, 98 67, 102 68 C 108 71, 106 81, 102 88 Z" fill="#3A3B35" />

      <ellipse cx="73" cy="107" rx="40" ry="34" fill="#1C1D1A" />
      <path d="M46 90 Q 73 74 101 88" fill="none" stroke="#3B3D37" stroke-width="2.6" stroke-linecap="round" opacity=".85" />

      <!-- cheeks -->
      <ellipse cx="48" cy="117" rx="6.5" ry="3.4" fill="#C9826F" opacity=".3" />
      <ellipse cx="98" cy="117" rx="6.5" ry="3.4" fill="#C9826F" opacity=".3" />

      <!-- muzzle, nose, mouth -->
      <ellipse cx="73" cy="121" rx="16" ry="10.5" fill="#292A26" />
      <path d="M68 113.5 Q 73 110.5 78 113.5 Q 75.5 118.5 73 118.5 Q 70.5 118.5 68 113.5 Z" fill="#5A564D" />
      <path d="M73 118.5 L 73 121.5 M 67 122.5 Q 70 126 73 121.5 Q 76 126 79 122.5" fill="none" stroke="#56534B" stroke-width="1.4" stroke-linecap="round" />

      <!-- whiskers -->
      <g stroke="#FFFFFF" stroke-opacity=".22" stroke-width=".9" stroke-linecap="round">
        <path d="M59 120 L 38 116" /><path d="M59 124 L 39 126" />
        <path d="M87 120 L 108 116" /><path d="M87 124 L 107 126" />
      </g>

      <!-- eyes, open -->
      <g class="eyes-open">
        <g class="eye"><ellipse cx="58" cy="104" rx="8.6" ry="8.2" fill="#C3D46A" /><ellipse class="pupil" cx="58" cy="105" rx="3.7" ry="5.4" fill="#0E0F0D" /><circle cx="60.6" cy="101.4" r="1.9" fill="#FFFFFF" /></g>
        <g class="eye"><ellipse cx="88" cy="104" rx="8.6" ry="8.2" fill="#C3D46A" /><ellipse class="pupil" cx="88" cy="105" rx="3.7" ry="5.4" fill="#0E0F0D" /><circle cx="90.6" cy="101.4" r="1.9" fill="#FFFFFF" /></g>
      </g>
      <!-- eyes, shut -->
      <g class="eyes-shut" fill="none" stroke="#77756A" stroke-width="2.2" stroke-linecap="round">
        <path d="M50 104 Q 58 110.5 66 104" /><path d="M80 104 Q 88 110.5 96 104" />
      </g>
    </g>

    <!-- z's while asleep -->
    <g class="zzz" fill="#2F5D46" font-style="italic">
      <text x="104" y="60" font-size="15">z</text>
      <text x="116" y="44" font-size="19">z</text>
      <text x="131" y="26" font-size="23">z</text>
    </g>
  </g>
</svg>

<style>
  .panther { display: block; width: 100%; height: auto; overflow: visible; }
  .panther text { font-family: var(--font); }

  .tail { transform-origin: 246px 122px; animation: tail 5.5s ease-in-out infinite alternate; }
  .breath { transform-origin: 176px 139px; animation: breath 4.2s ease-in-out infinite; }
  .ear-r { transform-origin: 96px 92px; animation: twitch 9s ease-in-out infinite; }
  .eye { transform-box: fill-box; transform-origin: center; }
  .zzz text { opacity: 0; animation: z 4.2s ease-in-out infinite; }
  .zzz text:nth-child(2) { animation-delay: 1.4s; }
  .zzz text:nth-child(3) { animation-delay: 2.8s; }

  @keyframes tail { from { transform: rotate(-7deg); } to { transform: rotate(9deg); } }
  @keyframes breath { 0%, 100% { transform: scale(1, 1); } 50% { transform: scale(1.012, 1.035); } }
  @keyframes twitch { 0%, 90%, 100% { transform: rotate(0); } 93% { transform: rotate(-9deg); } 96% { transform: rotate(3deg); } }
  @keyframes blink { 0%, 92%, 100% { transform: scaleY(1); } 95% { transform: scaleY(0.08); } }
  @keyframes z { 0% { opacity: 0; transform: translate(0, 6px); } 25% { opacity: .75; } 80% { opacity: 0; transform: translate(6px, -10px); } 100% { opacity: 0; } }

  /* Mood. Sleepy by default; hovering wakes it up. */
  .eyes-open { display: none; }
  :global(html[data-mood='curious']) .eyes-open,
  .panther:hover .eyes-open { display: inline; }
  :global(html[data-mood='curious']) .eyes-shut,
  :global(html[data-mood='curious']) .zzz,
  .panther:hover .eyes-shut, .panther:hover .zzz { display: none; }
  :global(html[data-mood='curious']) .eye { animation: blink 6s ease-in-out infinite; }
  :global(html[data-mood='curious']) .eye + .eye { animation-delay: .04s; }

  @media (prefers-reduced-motion: reduce) {
    .tail, .breath, .ear-r, .eye, .zzz text { animation: none !important; }
    .zzz text { opacity: .6; }
  }
</style>
