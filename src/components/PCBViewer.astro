---
interface Props {
  src: string;
  alt: string;
  fallback?: string;
  disableZoom?: boolean;
  hint?: string;
  cameraOrbit?: string;
  minCameraOrbit?: string;
  maxCameraOrbit?: string;
  // When false, the viewer just spins on its own (no drag, no zoom, no hint)
  // and lets pointer events pass through — used as a card preview.
  interactive?: boolean;
}

const {
  src,
  alt,
  disableZoom = false,
  hint = 'Drag to rotate · Scroll to zoom',
  cameraOrbit = '45deg 55deg 0.3m',
  minCameraOrbit = 'auto auto 0.2m',
  maxCameraOrbit = 'auto auto 0.6m',
  interactive = true,
} = Astro.props;

const modelViewerInteractionAttrs = disableZoom
  ? { 'disable-zoom': true, 'touch-action': 'pan-y' }
  : { 'touch-action': 'none' };

// Card-preview mode: continuous auto-rotate, no user interaction.
const interactionAttrs = interactive
  ? { 'camera-controls': true, 'auto-rotate-delay': '2000', ...modelViewerInteractionAttrs }
  : { 'auto-rotate-delay': '0' };
---

<div class="viewer-container" data-native-cursor data-disable-zoom={disableZoom ? 'true' : 'false'} data-interactive={interactive ? 'true' : 'false'}>
  <model-viewer
    src={src}
    alt={alt}
    data-native-cursor
    loading="eager"
    auto-rotate
    rotation-per-second="22deg"
    interaction-prompt="none"
    disable-tap
    {...interactionAttrs}
    shadow-intensity="1"
    shadow-softness="0.5"
    exposure="1"
    camera-orbit={cameraOrbit}
    min-camera-orbit={minCameraOrbit}
    max-camera-orbit={maxCameraOrbit}
    class="pcb-viewer"
  >
  </model-viewer>
  {interactive && <p class="viewer-hint">{hint}</p>}
</div>

<style>
  .viewer-container {
    position: relative;
    width: 100%;
  }

  .pcb-viewer {
    width: 100%;
    height: 450px;
    border-radius: var(--radius-lg);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    cursor: grab;
    touch-action: none;
  }

  .viewer-container[data-disable-zoom='true'] .pcb-viewer {
    touch-action: pan-y;
  }

  .pcb-viewer:active {
    cursor: grabbing;
  }

  .pcb-viewer:focus {
    outline: none;
  }

  /* Card-preview mode: spin only, let clicks reach the card underneath. */
  .viewer-container[data-interactive='false'] .pcb-viewer {
    cursor: inherit;
    pointer-events: none;
  }

  .viewer-hint {
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
  }

  @media (max-width: 768px) {
    .pcb-viewer { height: 300px; }
  }
</style>
