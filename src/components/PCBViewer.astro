---
interface Props {
  src: string;
  alt: string;
  fallback?: string;
  disableZoom?: boolean;
  hint?: string;
  cameraOrbit?: string;
  minCameraOrbit?: string;
  maxCameraOrbit?: string;
}

const {
  src,
  alt,
  disableZoom = false,
  hint = 'Drag to rotate · Scroll to zoom',
  cameraOrbit = '45deg 55deg 0.3m',
  minCameraOrbit = 'auto auto 0.2m',
  maxCameraOrbit = 'auto auto 0.6m',
} = Astro.props;

const modelViewerInteractionAttrs = disableZoom
  ? { 'disable-zoom': true, 'touch-action': 'pan-y' }
  : { 'touch-action': 'none' };
---

<div class="viewer-container" data-native-cursor data-disable-zoom={disableZoom ? 'true' : 'false'}>
  <model-viewer
    src={src}
    alt={alt}
    data-native-cursor
    camera-controls
    auto-rotate
    auto-rotate-delay="2000"
    rotation-per-second="20deg"
    interaction-prompt="none"
    disable-tap
    {...modelViewerInteractionAttrs}
    shadow-intensity="1"
    shadow-softness="0.5"
    exposure="1"
    camera-orbit={cameraOrbit}
    min-camera-orbit={minCameraOrbit}
    max-camera-orbit={maxCameraOrbit}
    class="pcb-viewer"
  >
  </model-viewer>
  <p class="viewer-hint">{hint}</p>
</div>

<style>
  .viewer-container {
    position: relative;
    width: 100%;
  }

  .pcb-viewer {
    width: 100%;
    height: 450px;
    border-radius: var(--radius-lg);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    cursor: grab;
    touch-action: none;
  }

  .viewer-container[data-disable-zoom='true'] .pcb-viewer {
    touch-action: pan-y;
  }

  .pcb-viewer:active {
    cursor: grabbing;
  }

  .pcb-viewer:focus {
    outline: none;
  }

  .viewer-hint {
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
  }

  @media (max-width: 768px) {
    .pcb-viewer { height: 300px; }
  }
</style>
