---
const currentYear = new Date().getFullYear();

const socialIcons = [
  {
    href: 'https://github.com/ofmohamm',
    label: 'GitHub',
    svg: `<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>`,
  },
  {
    href: 'https://linkedin.com/in/ofmohammed',
    label: 'LinkedIn',
    svg: `<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>`,
  },
  {
    href: 'mailto:mail.omarmohammed@gmail.com',
    label: 'Email',
    svg: `<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>`,
  },
];
const RESUME_URL = 'https://drive.google.com/file/d/1-0OkidhFCiwY4Qzrx7l75aHpLJc4_KkF/view?usp=sharing';
const RESUME_ICON = `<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>`;
---

<footer class="site-footer">
  <p class="footer-intent">
    Always looking to connect with builders, founders, and creators. If you
    are working on something in hardware, firmware, or silicon, I would like
    to hear about it.
    <a class="footer-intent-link" href="mailto:mail.omarmohammed@gmail.com">Get in touch</a>
  </p>
  <div class="footer-inner">
    <nav class="footer-links" aria-label="Profiles and resume">
      {socialIcons.map((s) => (
        <a class="footer-icon" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={s.svg} />
        </a>
      ))}
      <a class="footer-resume" href={RESUME_URL} target="_blank" rel="noopener noreferrer">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={RESUME_ICON} />
        Resume
      </a>
    </nav>
    <p class="footer-copy">&copy; {currentYear} Omar Mohammed</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: 2.5rem var(--gutter);
    margin-top: 7rem;
  }

  .footer-intent {
    max-width: 920px;
    margin: 0 auto 2rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-inline-size: 62ch;
  }

  .footer-intent-link {
    display: inline-block;
    margin-left: 0.35rem;
    font-weight: 500;
    color: var(--color-green-primary);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  .footer-intent-link:hover { color: var(--color-green-hover); }


  .footer-inner {
    max-width: 920px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.35rem;
  }

  .footer-icon {
    color: var(--color-text-primary);
    display: inline-flex;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .footer-icon:hover {
    color: var(--color-green-primary);
    transform: translateY(-2px);
  }

  .footer-resume {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-primary);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.34rem 0.72rem;
    line-height: 1;
    transition: color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }
  .footer-resume:hover {
    color: var(--color-green-primary);
    border-color: var(--color-green-primary);
    transform: translateY(-2px);
  }

  .footer-copy {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0;
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
  }
</style>
</content>
