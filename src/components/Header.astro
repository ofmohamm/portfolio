---
const navLinks = [
  { href: '#projects', label: 'Projects' },
  { href: '#skills', label: 'Skills' },
];

import { Image } from 'astro:assets';
import navLogo from '../assets/mo-logo.png';
---


<header class="site-header">
  <!-- DESKTOP NAV -->
  <nav class="nav-desktop">
    <a href="#hero" class="nav-logo" data-scroll-top aria-label="Back to top">
      <Image class="nav-logo-mark" src={navLogo} alt="Omar Mohammed" width={88} densities={[1, 2]} format="webp" loading="eager" />
    </a>

    <div class="nav-links">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </div>

    <div class="nav-right-spacer" aria-hidden="true"></div>
  </nav>

  <!-- MOBILE NAV BAR -->
  <nav class="nav-mobile-bar">
    <a href="#hero" class="nav-logo-mobile" data-scroll-top aria-label="Back to top">
      <Image class="nav-logo-mark" src={navLogo} alt="Omar Mohammed" width={88} densities={[1, 2]} format="webp" loading="eager" />
    </a>

    <div class="nav-mobile-actions">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link nav-link-mobile">{link.label}</a>
      ))}
    </div>
  </nav>
</header>

<style>
  .site-header {
    --header-height: 64px;
    --header-height-mobile: 56px;
    --z-header: 100;
    --z-menu: 200;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-header);
    background: rgba(250, 249, 246, 0.85);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .nav-desktop {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--header-height);
    padding: 0 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (min-width: 1024px) {
    .nav-desktop { padding: 0 3rem; }
    .nav-logo { left: 3rem; }
  }

  .nav-logo {
    position: absolute;
    left: 1.5rem;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .nav-logo-mark {
    height: 22px;
    width: auto;
    display: block;
  }

  .nav-logo:hover { opacity: 0.6; }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-primary);
    text-decoration: none;
    padding: 0.5rem 0.25rem;
    transition: color 0.2s ease;
  }
  .nav-link:hover { color: var(--color-green-primary); }

  /* Current-section indicator. Deliberately a hairline with no transition:
     on a two-item nav anything heavier reads as fussy. */
  .nav-link {
    position: relative;
  }

  .nav-link[aria-current='true']::after {
    content: '';
    position: absolute;
    left: 0.25rem;
    right: 0.25rem;
    bottom: 0.3rem;
    height: 1px;
    background: currentColor;
  }

  .nav-right-spacer { display: none; }

  /* MOBILE */
  .nav-mobile-bar { display: none; }

  @media (max-width: 900px) {
    .nav-desktop { display: none !important; }

    .nav-mobile-bar {
      display: flex !important;
      align-items: center;
      justify-content: space-between;
      height: var(--header-height-mobile);
      padding: 0 1rem;
    }

    .nav-logo-mobile {
      display: inline-flex;
      align-items: center;
      text-decoration: none;
    }

    .nav-logo-mobile .nav-logo-mark { height: 20px; }

    .nav-mobile-actions {
      display: inline-flex;
      align-items: center;
      gap: 1.1rem;
    }

    .nav-link-mobile {
      font-size: 0.8rem;
      padding: 0.25rem 0;
    }
  }
</style>

<script>
  // Marks the nav link for whichever section is currently in view. Uses
  // aria-current so it is announced, not just drawn.
  function wireNavActive() {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('.nav-link[href^="#"]')
    );
    if (links.length === 0) return;

    // Desktop and mobile navs both exist, so group links by target.
    const byHash = new Map<string, HTMLAnchorElement[]>();
    for (const link of links) {
      const hash = link.getAttribute('href');
      if (!hash || hash.length < 2) continue;
      const list = byHash.get(hash) ?? [];
      list.push(link);
      byHash.set(hash, list);
    }

    const sections = Array.from(byHash.keys())
      .map((hash) => document.querySelector<HTMLElement>(hash))
      .filter((el): el is HTMLElement => el !== null);
    if (sections.length === 0) return;
    if (!('IntersectionObserver' in window)) return; // no indicator is fine

    function setCurrent(hash: string | null) {
      for (const [h, els] of byHash) {
        for (const el of els) {
          if (h === hash) el.setAttribute('aria-current', 'true');
          else el.removeAttribute('aria-current');
        }
      }
    }

    const inBand = new Set<string>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const id = (entry.target as HTMLElement).id;
          if (entry.isIntersecting) inBand.add(id);
          else inBand.delete(id);
        }
        // Narrow band near the top third of the viewport, so normally only one
        // section qualifies. Ties resolve to document order.
        const current = sections.find((sec) => inBand.has(sec.id));
        setCurrent(current ? `#${current.id}` : null);
      },
      { rootMargin: '-40% 0px -55% 0px', threshold: 0 }
    );
    for (const sec of sections) io.observe(sec);
  }

  wireNavActive();
  document.addEventListener('astro:page-load', wireNavActive);

  function wireHeader() {
    document.querySelectorAll<HTMLAnchorElement>('[data-scroll-top]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });
  }

  wireHeader();
  document.addEventListener('astro:page-load', wireHeader);
</script>
