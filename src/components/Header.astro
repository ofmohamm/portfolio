---
const navLinks = [
  { href: '#projects', label: 'Projects' },
  { href: '#skills', label: 'Skills' },
];
const RESUME_URL = 'https://drive.google.com/file/d/1-0OkidhFCiwY4Qzrx7l75aHpLJc4_KkF/view?usp=sharing';
---

<header class="site-header">
  <!-- DESKTOP NAV -->
  <nav class="nav-desktop">
    <a href="#hero" class="nav-logo" data-scroll-top aria-label="Back to top">
      <span class="nav-logo-text">MO</span>
    </a>

    <div class="nav-links">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
      <a
        href={RESUME_URL}
        class="nav-resume"
        target="_blank"
        rel="noopener noreferrer"
      >
        Resume
      </a>
    </div>

    <div class="nav-right-spacer" aria-hidden="true"></div>
  </nav>

  <!-- MOBILE NAV BAR -->
  <nav class="nav-mobile-bar">
    <a href="#hero" class="nav-logo-mobile" data-scroll-top aria-label="Back to top">
      <span class="nav-logo-text">MO</span>
    </a>

    <div class="nav-mobile-actions">
      <a
        href={RESUME_URL}
        class="nav-resume nav-resume-mobile"
        target="_blank"
        rel="noopener noreferrer"
      >
        Resume
      </a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    --header-height: 64px;
    --header-height-mobile: 56px;
    --z-header: 100;
    --z-menu: 200;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-header);
    background: rgba(250, 249, 246, 0.85);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .nav-desktop {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--header-height);
    padding: 0 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (min-width: 1024px) {
    .nav-desktop { padding: 0 3rem; }
    .nav-logo { left: 3rem; }
  }

  .nav-logo {
    position: absolute;
    left: 1.5rem;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .nav-logo-text {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    color: var(--color-text-primary);
    padding: 4px 8px;
    border: 1px solid var(--color-text-primary);
    border-radius: 3px;
    line-height: 1;
  }

  .nav-logo:hover { opacity: 0.7; }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-primary);
    text-decoration: none;
    padding: 0.5rem 0.25rem;
    transition: color 0.2s ease;
  }
  .nav-link:hover { color: var(--color-green-primary); }

  .nav-resume {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-green-primary);
    background: transparent;
    border: 1px solid var(--color-green-primary);
    border-radius: var(--radius-md);
    padding: 0.4rem 0.9rem;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .nav-resume:hover {
    background: var(--color-green-primary);
    color: #FAF9F6;
  }

  .nav-right-spacer { display: none; }

  /* MOBILE */
  .nav-mobile-bar { display: none; }

  @media (max-width: 900px) {
    .nav-desktop { display: none !important; }

    .nav-mobile-bar {
      display: flex !important;
      align-items: center;
      justify-content: space-between;
      height: var(--header-height-mobile);
      padding: 0 1rem;
    }

    .nav-logo-mobile {
      display: inline-flex;
      align-items: center;
      text-decoration: none;
    }

    .nav-logo-mobile .nav-logo-text { font-size: 0.85rem; }

    .nav-mobile-actions {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
    }

    .nav-resume-mobile {
      font-size: 0.8rem;
      padding: 0.34rem 0.72rem;
      border-radius: 6px;
    }
  }
</style>

<script>
  function wireHeader() {
    document.querySelectorAll<HTMLAnchorElement>('[data-scroll-top]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });
  }

  wireHeader();
  document.addEventListener('astro:page-load', wireHeader);
</script>
