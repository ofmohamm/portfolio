---
import './figure.css';
import { scene, VIEW, MAX_US } from './lib/array';
const D0 = { yaw: -28, pitch: 22, az: 35, el: 30, raised: true };
const s = scene(D0);
const f = (n: number) => n.toFixed(1);
---

<figure class="fig fig-array" data-fig="array" aria-label="Five microphones on a ring plus one raised on a post, with a drone you can move">
  <div class="fig-stage">
    <div class="fig-array-view">
      <svg class="fig-svg fig-array-svg" viewBox={`0 0 ${VIEW.W} ${VIEW.H}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <polyline class="ar-orbit" points={s.orbit} fill="none" stroke="var(--figure-grid)" stroke-dasharray="3 5" />
        <polygon class="ar-ring" points={s.ring} fill="var(--figure-accent)" fill-opacity="0.06" stroke="var(--figure-ink)" stroke-opacity="0.45" stroke-width="1.2" />
        <g class="ar-spokes">
          {s.mics.slice(0, 5).map((m) => (
            <line x1={f(s.center.x)} y1={f(s.center.y)} x2={f(m.x)} y2={f(m.y)} stroke="var(--figure-grid)" />
          ))}
        </g>
        <!-- vertical guides: drone and ghost share one foot point on the ground -->
        <line class="ar-drop" x1={f(s.drone.x)} y1={f(s.drone.y)} x2={f(s.foot.x)} y2={f(s.foot.y)} stroke="var(--figure-muted)" stroke-dasharray="3 3" />
        <line class="ar-gdrop" x1={f(s.ghost.x)} y1={f(s.ghost.y)} x2={f(s.foot.x)} y2={f(s.foot.y)} stroke="var(--figure-warn)" stroke-opacity="0" stroke-dasharray="3 3" />
        <circle class="ar-foot" cx={f(s.foot.x)} cy={f(s.foot.y)} r="2.5" fill="var(--figure-muted)" />
        <line class="ar-est0" x1={f(s.center.x)} y1={f(s.center.y)} x2={f(s.ests[0].x)} y2={f(s.ests[0].y)} stroke="var(--figure-accent)" stroke-width="1.6" />
        <line class="ar-est1" x1={f(s.center.x)} y1={f(s.center.y)} x2={f(s.center.x)} y2={f(s.center.y)} stroke="var(--figure-warn)" stroke-width="1.6" stroke-dasharray="5 4" stroke-opacity="0" />
        <line class="ar-post" x1={f(s.center.x)} y1={f(s.center.y)} x2={f(s.postTop.x)} y2={f(s.postTop.y)} stroke="var(--figure-ink)" stroke-opacity="0.6" stroke-width="2" />
        <g class="ar-mics">
          {s.mics.map((m) => (
            <circle class="ar-mic" data-i={m.i} cx={f(m.x)} cy={f(m.y)} r={m.i === 5 ? 6.5 : 5.5}
              fill={m.i === 5 ? 'var(--figure-accent)' : 'var(--figure-ink)'} stroke="#FAF9F6" stroke-width="1.5" />
          ))}
        </g>
        <g class="ar-ghost" transform={`translate(${f(s.ghost.x)},${f(s.ghost.y)})`} opacity="0">
          <path d="M-11,-11L11,11M-11,11L11,-11" stroke="var(--figure-warn)" stroke-width="2" />
          {[[-11,-11],[11,11],[-11,11],[11,-11]].map(([x,y]) => <circle cx={x} cy={y} r="5" fill="none" stroke="var(--figure-warn)" stroke-width="1.5" />)}
        </g>
        <g class="ar-drone" transform={`translate(${f(s.drone.x)},${f(s.drone.y)})`}>
          <path d="M-11,-11L11,11M-11,11L11,-11" stroke="var(--figure-ink)" stroke-width="2" />
          {[[-11,-11],[11,11],[-11,11],[11,-11]].map(([x,y]) => <circle cx={x} cy={y} r="5" fill="#FAF9F6" stroke="var(--figure-ink)" stroke-width="1.5" />)}
          <rect x="-4" y="-4" width="8" height="8" rx="1.5" fill="var(--figure-ink)" />
        </g>
      </svg>
      <span class="fig-label warn ar-ghost-label" style={`left:${(s.ghost.x / VIEW.W) * 100}%;top:${((s.ghost.y + 24) / VIEW.H) * 100}%`} hidden>indistinguishable</span>
      <span class="fig-hint ar-hint">drag to rotate</span>
    </div>

    <div class="fig-array-controls">
      <div class="fig-slider">
        <label for="ar-az">azimuth</label>
        <input id="ar-az" type="range" min="0" max="359" step="1" value={D0.az} />
        <output for="ar-az" class="ar-az-out">{D0.az}°</output>
      </div>
      <div class="fig-slider">
        <label for="ar-el">elevation</label>
        <input id="ar-el" type="range" min="5" max="70" step="1" value={D0.el} />
        <output for="ar-el" class="ar-el-out">{D0.el}°</output>
      </div>
    </div>

    <div class="ar-bars" aria-label="Arrival delay at each microphone">
      {s.bars.map((v, i) => (
        <div class="ar-bar-row" data-i={i}>
          <span class="ar-bar-name">{i === 5 ? 'mic 6, raised' : `mic ${i + 1}`}</span>
          <span class="ar-bar-track"><span class="ar-bar-fill" style={`width:${((v ?? 0) / MAX_US) * 100}%`}></span></span>
          <span class="ar-bar-val">{v === null ? 'off' : `${Math.round(v)} µs`}</span>
        </div>
      ))}
    </div>

    <div class="fig-row">
      <div class="fig-group">
        <span class="fig-seg-label">raised mic</span>
        <div class="fig-seg" role="group" aria-label="Raised microphone">
          <button type="button" data-raised="on" aria-pressed="true">on</button>
          <button type="button" data-raised="off" aria-pressed="false">off</button>
        </div>
      </div>
      <div class="fig-group">
        <span class="fig-seg-label">shared clock</span>
        <div class="fig-seg" role="group" aria-label="Shared clock">
          <button type="button" data-clock="on" aria-pressed="true">on</button>
          <button type="button" data-clock="off" aria-pressed="false">off</button>
        </div>
      </div>
    </div>
  </div>
  <figcaption class="fig-caption">
    Ring radius 15 cm, post 15 cm. Widest baseline 28.5 cm, so the longest delay is 832 µs. At 48 kHz one sample is 20.8 µs, about 40 samples across the whole range. The solid line is the direction the array solves for.
  </figcaption>
</figure>

<style>
  .fig-array-view { position: relative; }
  .fig-array-svg { touch-action: pan-y; cursor: grab; user-select: none; -webkit-user-select: none; }
  .fig-array-svg:active { cursor: grabbing; }
  .ar-hint { position: absolute; right: 0.2rem; top: 0.1rem; }
  .fig-array-controls { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem 1.5rem; margin-top: 0.4rem; }
  @media (max-width: 520px) { .fig-array-controls { grid-template-columns: 1fr; } }
  .ar-bars { display: grid; gap: 0.3rem; margin-top: 0.75rem; }
  .ar-bar-row { display: grid; grid-template-columns: 6.6rem 1fr 3.6rem; align-items: center; gap: 0.6rem; font-size: 0.72rem; }
  .ar-bar-name { color: var(--color-text-muted); white-space: nowrap; }
  .ar-bar-track { height: 8px; background: var(--figure-grid); border-radius: 4px; overflow: hidden; }
  .ar-bar-fill { display: block; height: 100%; background: var(--figure-accent); border-radius: 4px; }
  .ar-bar-row[data-i='5'] .ar-bar-fill { background: var(--figure-accent); opacity: 0.75; }
  .ar-bar-row.off .ar-bar-name, .ar-bar-row.off .ar-bar-val { opacity: 0.5; }
  .ar-bar-val { font-family: var(--font-mono); text-align: right; font-variant-numeric: tabular-nums; }
</style>

<script>
  import { scene, VIEW, MAX_US, SAMPLE_US } from './lib/array';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  function init(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const svg = q<SVGSVGElement>('.fig-array-svg');
    const el = {
      orbit: q<SVGPolylineElement>('.ar-orbit'), ring: q<SVGPolygonElement>('.ar-ring'),
      spokes: [...root.querySelectorAll<SVGLineElement>('.ar-spokes line')],
      drop: q<SVGLineElement>('.ar-drop'), gdrop: q<SVGLineElement>('.ar-gdrop'),
      foot: q<SVGCircleElement>('.ar-foot'), post: q<SVGLineElement>('.ar-post'),
      est0: q<SVGLineElement>('.ar-est0'), est1: q<SVGLineElement>('.ar-est1'),
      mics: [...root.querySelectorAll<SVGCircleElement>('.ar-mic')],
      micsG: q<SVGGElement>('.ar-mics'),
      drone: q<SVGGElement>('.ar-drone'), ghost: q<SVGGElement>('.ar-ghost'),
      ghostLabel: q<HTMLElement>('.ar-ghost-label'),
      az: q<HTMLInputElement>('#ar-az'), elv: q<HTMLInputElement>('#ar-el'),
      azOut: q<HTMLOutputElement>('.ar-az-out'), elOut: q<HTMLOutputElement>('.ar-el-out'),
      rows: [...root.querySelectorAll<HTMLElement>('.ar-bar-row')],
    };
    const st = { yaw: -28, pitch: 22, az: +el.az.value, el: +el.elv.value, raised: true, clock: true };
    let jitter: number[] | undefined;
    let raf = 0, jraf = 0, lastJitter = 0, visible = true;

    const setLine = (l: SVGLineElement, a: { x: number; y: number }, b: { x: number; y: number }) => {
      l.setAttribute('x1', a.x.toFixed(1)); l.setAttribute('y1', a.y.toFixed(1));
      l.setAttribute('x2', b.x.toFixed(1)); l.setAttribute('y2', b.y.toFixed(1));
    };
    const render = () => {
      raf = 0;
      const s = scene({ ...st, jitter: st.clock ? undefined : jitter });
      el.orbit.setAttribute('points', s.orbit);
      el.ring.setAttribute('points', s.ring);
      el.spokes.forEach((l, i) => setLine(l, s.center, s.mics[i]));
      setLine(el.post, s.center, s.postTop);
      setLine(el.drop, s.drone, s.foot);
      setLine(el.gdrop, s.ghost, s.foot);
      el.foot.setAttribute('cx', s.foot.x.toFixed(1)); el.foot.setAttribute('cy', s.foot.y.toFixed(1));
      setLine(el.est0, s.center, s.ests[0]);
      if (s.ests[1]) setLine(el.est1, s.center, s.ests[1]);
      el.est1.setAttribute('stroke-opacity', st.raised ? '0' : '1');
      // Draw nearer mics last so the ring reads correctly as it rotates.
      s.mics.slice().sort((a, b) => b.depth - a.depth).forEach((m) => {
        const c = el.mics[m.i];
        c.setAttribute('cx', m.x.toFixed(1)); c.setAttribute('cy', m.y.toFixed(1));
        el.micsG.appendChild(c);
      });
      el.mics[5].setAttribute('opacity', st.raised ? '1' : '0.25');
      el.post.setAttribute('stroke-opacity', st.raised ? '0.6' : '0.2');
      el.drone.setAttribute('transform', `translate(${s.drone.x.toFixed(1)},${s.drone.y.toFixed(1)})`);
      el.ghost.setAttribute('transform', `translate(${s.ghost.x.toFixed(1)},${s.ghost.y.toFixed(1)})`);
      el.ghost.setAttribute('opacity', st.raised ? '0' : '1');
      el.gdrop.setAttribute('stroke-opacity', st.raised ? '0' : '0.8');
      el.ghostLabel.hidden = st.raised;
      el.ghostLabel.style.left = `${(s.ghost.x / VIEW.W) * 100}%`;
      el.ghostLabel.style.top = `${((s.ghost.y + 26) / VIEW.H) * 100}%`;
      s.bars.forEach((v, i) => {
        const row = el.rows[i];
        row.classList.toggle('off', v === null);
        (row.querySelector('.ar-bar-fill') as HTMLElement).style.width = `${(Math.max(0, v ?? 0) / MAX_US) * 100}%`;
        (row.querySelector('.ar-bar-val') as HTMLElement).textContent = v === null ? 'off' : `${Math.round(v)} µs`;
      });
      el.azOut.textContent = `${st.az}°`; el.elOut.textContent = `${st.el}°`;
      if (!st.clock) loop();
    };
    const schedule = () => { if (!raf) raf = requestAnimationFrame(render); };

    // Unsynchronised capture: each mic drifts by up to +/-1.5 samples, redrawn
    // every 500 ms. Driven by rAF and paused when hidden or off screen.
    function newJitter() { jitter = Array.from({ length: 6 }, () => (Math.random() - 0.5) * 3 * SAMPLE_US * 1e-6); }
    // Separate handle from the input redraw, so a slider drag never waits for
    // the next jitter tick.
    function loop() {
      if (jraf || !visible || document.hidden || st.clock || reduce) return;
      jraf = requestAnimationFrame((now) => {
        jraf = 0;
        if (now - lastJitter > 500) { lastJitter = now; newJitter(); schedule(); }
        else loop();
      });
    }

    el.az.addEventListener('input', () => { st.az = +el.az.value; schedule(); });
    el.elv.addEventListener('input', () => { st.el = +el.elv.value; schedule(); });
    root.querySelectorAll<HTMLButtonElement>('[data-raised]').forEach((b, _, all) => b.addEventListener('click', () => {
      st.raised = b.dataset.raised === 'on';
      all.forEach((x) => x.setAttribute('aria-pressed', String(x === b))); schedule();
    }));
    root.querySelectorAll<HTMLButtonElement>('[data-clock]').forEach((b, _, all) => b.addEventListener('click', () => {
      st.clock = b.dataset.clock === 'on';
      all.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      if (!st.clock) { newJitter(); lastJitter = performance.now(); }
      schedule();
    }));

    // Orbit: horizontal drag spins the view. Vertical drag tilts it with a
    // mouse; on touch the vertical axis is left to the page so it still scrolls.
    let drag: { x: number; y: number; yaw: number; pitch: number; type: string } | null = null;
    svg.addEventListener('pointerdown', (e) => {
      drag = { x: e.clientX, y: e.clientY, yaw: st.yaw, pitch: st.pitch, type: e.pointerType };
      svg.setPointerCapture(e.pointerId);
    });
    svg.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const k = 300 / svg.getBoundingClientRect().width;
      st.yaw = drag.yaw - (e.clientX - drag.x) * 0.6 * k;
      if (drag.type === 'mouse') st.pitch = Math.max(4, Math.min(80, drag.pitch + (e.clientY - drag.y) * 0.4 * k));
      schedule();
    });
    const end = () => { drag = null; };
    svg.addEventListener('pointerup', end);
    svg.addEventListener('pointercancel', end);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) loop(); });

    const vio = new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible) loop(); });
    vio.observe(root);
    render();
  }

  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { init(e.target as HTMLElement); io.unobserve(e.target); }
  });
  document.querySelectorAll<HTMLElement>('[data-fig="array"]').forEach((el) => io.observe(el));
</script>
