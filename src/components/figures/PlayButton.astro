---
// Pause / play for a figure's own motion. Wired up by player() in lib/ui.ts;
// hidden without JS and under reduced motion, where nothing moves anyway.
---
<button type="button" class="fig-play" aria-pressed="true" aria-label="Pause animation">
  <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="2" width="3.5" height="12" rx="1" /><rect x="9.5" y="2" width="3.5" height="12" rx="1" /></svg>
  <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.6v10.8a.8.8 0 0 0 1.2.7l8.8-5.4a.8.8 0 0 0 0-1.4L5.2 1.9A.8.8 0 0 0 4 2.6Z" /></svg>
</button>
