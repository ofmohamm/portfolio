---
import ForestLayout from '../layouts/ForestLayout.astro';
import Statement from '../components/forest/Statement.astro';
import LeafMark from '../components/forest/LeafMark.astro';
import { getCollection, getEntry } from 'astro:content';

// Content is YAML on disk (src/content), read at build time.
const [hero, seo, skills, zarf, projectEntries] = await Promise.all([
  getEntry('site', 'hero'),
  getEntry('site', 'seo'),
  getEntry('site', 'skills'),
  getEntry('site', 'zarf'),
  getCollection('projects'),
]);

const year = (s?: string) => s?.match(/\d{4}/)?.[0] ?? '';
// Current work first, then past; each in its own order.
const projects = projectEntries
  .map((e) => ({
    id: e.id,
    name: e.data.name,
    year: year(e.data.subtitle),
    current: e.data.status === 'current',
    label: e.data.org ? `${e.data.org}${e.data.status === 'current' ? ' · In progress' : ''}` : '',
    order: e.data.order,
  }))
  .sort((a, b) => Number(b.current) - Number(a.current) || a.order - b.order);

// Keep "@", "|" and "&" glued to the word before them so a wrapped line never starts with one.
const glue = (s: string) => s.replace(/ ([@|&]) /g, ' $1 ');
const [hello, ...rest] = (hero?.data.positioning ?? []);
---

<ForestLayout title={seo?.data.title ?? 'Omar Mohammed'} description={seo?.data.description}>
  <div class="hero-art"><Statement layout="hero" /></div>

  <h1 class="hello">{glue(hello ?? '')}</h1>
  {rest.map((line) => <p class="intro">{glue(line)}</p>)}

  {zarf && (
    <a class="venture" href={zarf.data.url} target="_blank" rel="noopener noreferrer">
      <span class="venture-logo" aria-hidden="true">Z</span>
      <span class="venture-text">
        <span class="venture-name">{zarf.data.name} <span class="tag">{zarf.data.status}</span></span>
        <span class="venture-line">{zarf.data.oneLiner}</span>
      </span>
      <span class="venture-arrow" aria-hidden="true">↗</span>
    </a>
  )}

  <section id="projects">
    <h2><LeafMark />Projects</h2>
    <ul class="rows">
      {projects.map((p) => (
        <li>
          <a class="row" href={`/work/${p.id}/`}>
            <span class="year">{p.year}</span>
            <span class="row-main">
              <span class="row-title">{p.name}</span>
              {p.label && <span class="tag">{p.label}</span>}
            </span>
            <span class="cue">View details</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="skills">
    <h2><LeafMark />Skills</h2>
    <dl class="skills">
      {(skills?.data.groups ?? []).map((g) => (
        <>
          <dt>{g.label}</dt>
          <dd>{g.items.join(', ')}</dd>
        </>
      ))}
    </dl>
  </section>
</ForestLayout>

<style>
  .hero-art { margin: -64px 0 20px; }
  @media (max-width: 600px) { .hero-art { margin-top: -24px; } }

  .hello {
    font-size: clamp(1.9rem, 5vw, 2.5rem);
    line-height: 1.15;
    font-style: italic;
    font-weight: 500;
    text-wrap: balance;
  }
  .intro { margin-top: 14px; max-width: 34em; color: var(--ink); text-wrap: pretty; }

  /* ---- Zarf Health: the one boxed thing on the page, the whole card is the link */
  .venture {
    display: flex; align-items: center; gap: 16px;
    margin-top: 32px; padding: 16px 18px;
    border: 1px solid color-mix(in srgb, var(--forest) 22%, transparent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--forest) 4%, var(--paper));
    color: var(--ink); text-decoration: none;
    transition: border-color .15s ease, background-color .15s ease, transform .15s ease;
  }
  .venture:hover { border-color: var(--forest); background: color-mix(in srgb, var(--forest) 7%, var(--paper)); }
  .venture-logo {
    flex: none; width: 48px; height: 48px; border-radius: 10px; display: grid; place-items: center;
    background: var(--forest); color: var(--paper); font-style: italic; font-weight: 700; font-size: 1.5rem;
  }
  .venture-text { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .venture-name { font-weight: 700; }
  .venture-line { color: var(--gray); line-height: 1.45; }
  .venture-arrow { flex: none; color: var(--forest); font-size: 1.2rem; transition: transform .15s ease; }
  .venture:hover .venture-arrow { transform: translate(2px, -2px); }

  .tag {
    font-size: .68em; font-weight: 600; letter-spacing: .1em; text-transform: uppercase;
    color: var(--gray); white-space: nowrap;
  }
  .venture-name .tag { margin-left: 6px; }
  @media (max-width: 520px) {
    .venture { align-items: flex-start; gap: 12px; padding: 14px; }
    .venture-logo { width: 40px; height: 40px; font-size: 1.25rem; }
    .venture-name .tag { display: block; margin: 2px 0 4px; }
  }

  /* ---- Projects: year, then title; the whole row is the link */
  .rows { list-style: none; margin: 0; padding: 0; }
  .rows li + li { margin-top: 6px; }
  .row {
    display: grid; grid-template-columns: 3.25rem 1fr auto; column-gap: 1rem; align-items: baseline;
    padding: 8px 0; color: var(--ink); text-decoration: none;
  }
  .year { color: var(--gray); font-variant-numeric: tabular-nums lining-nums; }
  .row-main { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 10px; }
  .row-title {
    color: var(--forest); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--forest) 35%, transparent);
  }
  .row:hover .row-title { text-decoration-color: currentColor; }
  .cue { color: var(--gray); font-size: .8em; white-space: nowrap; }
  /* "View details" appears on hover where hover exists; always visible on phones. */
  @media (hover: hover) and (pointer: fine) {
    .cue { opacity: 0; transform: translateX(-4px); transition: opacity .15s ease, transform .15s ease; }
    .row:hover .cue, .row:focus-visible .cue { opacity: 1; transform: none; }
  }
  @media (max-width: 520px) {
    .row { grid-template-columns: 3rem 1fr; }
    .cue { grid-column: 2; }
  }

  /* ---- Skills: label, then the list */
  .skills { display: grid; grid-template-columns: 11rem 1fr; gap: 12px 1rem; margin: 0; }
  .skills dt { font-weight: 700; }
  .skills dd { margin: 0; color: var(--gray); }
  @media (max-width: 560px) {
    .skills { grid-template-columns: 1fr; gap: 0; }
    .skills dd + dt { margin-top: 12px; }
  }
</style>
