---
import ForestLayout from '../layouts/ForestLayout.astro';
import Statement from '../components/forest/Statement.astro';
import LeafMark from '../components/forest/LeafMark.astro';
import { getCollection, getEntry } from 'astro:content';
import { inlineMd } from '../lib/inline-md';

// Content is YAML on disk (src/content), read at build time.
const [hero, seo, skills, zarf, projectEntries] = await Promise.all([
  getEntry('site', 'hero'),
  getEntry('site', 'seo'),
  getEntry('site', 'skills'),
  getEntry('site', 'zarf'),
  getCollection('projects'),
]);

// One or two lines per project on this page. A project without its own page
// (page: false) shows its whole write-up here instead of the one-liner.
const projects = projectEntries
  .map((e) => {
    const d = e.data;
    const firstPara = d.body.find((b): b is string => typeof b === 'string') ?? '';
    return {
      id: e.id,
      name: d.name,
      // Ongoing work reads "Present" rather than a range.
      when: d.status === 'current' ? 'Present' : (d.when ?? ''),
      current: d.status === 'current',
      label: d.org ?? '',
      line: d.page ? (d.oneLiner ?? '') : firstPara,
      href: d.page ? `/work/${e.id}/` : null,
      order: d.order,
    };
  })
  .sort((a, b) => Number(b.current) - Number(a.current) || a.order - b.order);   // current first

const groups = [{ id: 'projects', label: 'Projects', items: projects }];

// Keep "@", "|" and "&" glued to the word before them so a wrapped line never starts with one.
const glue = (s: string) => s.replace(/ ([@|&]) /g, ' $1 ');
const [hello, ...rest] = (hero?.data.positioning ?? []);
---

<ForestLayout title={seo?.data.title ?? 'Omar Mohammed'} description={seo?.data.description}>
  <div class="hero-art"><Statement layout="hero" /></div>

  <h1 class="hello">{glue(hello ?? '')}</h1>
  {rest.map((line) => <p class="intro">{glue(line)}</p>)}

  {groups.map((g) => (
    <section id={g.id}>
      <h2><LeafMark />{g.label}</h2>
      <ul class="projects">
        {zarf && (
          <li class="project">
            <div class="project-head">
              <a class="project-title zarf-mark" href={zarf.data.url} target="_blank" rel="noopener noreferrer"
                aria-label={`${zarf.data.name} (opens zarfhealth.com)`}>
                <img src="/images/zarf-wordmark.svg" alt="" width="60" height="24" />
              </a>
              <span class="when">Present</span>
            </div>
            <div class="tag">Co-founder</div>
            <p class="project-line">{zarf.data.oneLiner}</p>
          </li>
        )}
        {g.items.map((p) => (
          <li class="project">
            <div class="project-head">
              {p.href
                ? <a class="project-title" href={p.href}>{p.name}</a>
                : <span class="project-title project-title--plain">{p.name}</span>}
              {p.when && <span class="when">{p.when}</span>}
            </div>
            {p.label && <div class="tag">{p.label}</div>}
            <p class="project-line" set:html={inlineMd(p.line)} />
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section id="skills">
    <h2><LeafMark />Skills</h2>
    <dl class="skills">
      {(skills?.data.groups ?? []).map((g) => (
        <>
          <dt>{g.label}</dt>
          <dd>{g.items.join(', ')}</dd>
        </>
      ))}
    </dl>
  </section>
</ForestLayout>

<style>
  .hero-art { margin: -64px 0 20px; }
  @media (max-width: 600px) { .hero-art { margin-top: -24px; } }

  .hello {
    font-size: clamp(1.9rem, 5vw, 2.5rem);
    line-height: 1.15;
    font-style: italic;
    font-weight: 500;
    text-wrap: balance;
  }
  .intro { margin-top: 14px; max-width: 34em; color: var(--ink); text-wrap: pretty; }

  .tag {
    font-size: .68em; font-weight: 600; letter-spacing: .1em; text-transform: uppercase;
    color: var(--gray); white-space: nowrap;
  }
  .when { color: var(--gray); font-size: .85em; white-space: nowrap; font-variant-numeric: lining-nums; }

  /* ---- Projects: title and months, label, one or two lines */
  .projects { list-style: none; margin: 0; padding: 0; }
  .project + .project { margin-top: 30px; }
  .project-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; column-gap: 16px; }
  .project-title { font-weight: 700; }
  /* Zarf's title is its wordmark. It gets the same forest underline as every
     other clickable title, so it reads as a link without an icon. */
  .zarf-mark {
    display: inline-block; padding-bottom: 5px; text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--forest) 35%, transparent);
    transition: border-color .15s ease, opacity .15s ease;
  }
  .zarf-mark img { display: block; height: 24px; width: auto; }
  .project-head:has(.zarf-mark) { align-items: center; }
  .zarf-mark:hover { border-bottom-color: var(--forest); opacity: .82; }
  .project-title--plain { color: var(--ink); }
  .project .tag { margin-top: 2px; }
  .project-line { margin-top: 6px; color: var(--ink); text-wrap: pretty; }
  @media (max-width: 520px) {
    .project-head { flex-direction: column; }
  }

  /* ---- Skills: label, then the list */
  .skills { display: grid; grid-template-columns: 11rem 1fr; gap: 12px 1rem; margin: 0; }
  .skills dt { font-weight: 700; }
  .skills dd { margin: 0; color: var(--gray); }
  @media (max-width: 560px) {
    .skills { grid-template-columns: 1fr; gap: 0; }
    .skills dd + dt { margin-top: 12px; }
  }
</style>
