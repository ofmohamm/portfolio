---
import BaseLayout from '../layouts/BaseLayout.astro';
import InteractiveBackground from '../components/InteractiveBackground';
import PCBViewer from '../components/PCBViewer.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

// All content below is managed through the dashboard at /keystatic.
const reader = createReader(process.cwd(), keystaticConfig);

const [hero, featuredProject, skillsData, seo, projectEntries] = await Promise.all([
  reader.singletons.hero.read(),
  reader.singletons.featured.read(),
  reader.singletons.skills.read(),
  reader.singletons.seo.read(),
  reader.collections.projects.all(),
]);

const projects = projectEntries
  .map(({ slug, entry }) => ({
    id: slug,
    name: entry.name,
    subtitle: entry.subtitle,
    oneLiner: entry.oneLiner,
    order: entry.order,
    poster: entry.poster ?? undefined,
    model3d: entry.mediaType === '3d' ? entry.model3d ?? undefined : undefined,
    video: entry.mediaType === 'video' ? entry.video ?? undefined : undefined,
    tech: entry.tech,
    github: entry.github ?? undefined,
    body: entry.body,
    specs: entry.specs.map((s) => [s.key, s.value] as const),
  }))
  .sort((a, b) => a.order - b.order);

const skills = (skillsData?.groups ?? []).map((g) => ({
  label: g.label,
  items: g.items,
}));

// Profiles as icons + a plain Resume text link.
const socialIcons = [
  {
    href: 'https://github.com/ofmohamm',
    label: 'GitHub',
    filled: true,
    svg: `<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>`,
  },
  {
    href: 'https://linkedin.com/in/ofmohammed',
    label: 'LinkedIn',
    filled: true,
    svg: `<path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>`,
  },
  {
    href: 'mailto:mail.omarmohammed@gmail.com',
    label: 'Email',
    filled: false,
    svg: `<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>`,
  },
];
const RESUME_URL = 'https://drive.google.com/file/d/1-0OkidhFCiwY4Qzrx7l75aHpLJc4_KkF/view?usp=sharing';
---

<BaseLayout
  title={seo?.title ?? 'Omar Mohammed — FPGA, embedded firmware, PCB design'}
  description={seo?.description ?? 'Hardware design focused EE student at Syracuse. FPGA accelerators (Vivado, SystemVerilog, VHDL), embedded firmware (C/C++, LoRaWAN), and PCB design (KiCad).'}
>
  <!-- ============ HERO ============ -->
  <section id="hero" class="snap-section hero">
    <InteractiveBackground client:load />

    <div class="hero-inner">
      <img
        class="hero-signature"
        src="/images/logo.png"
        alt={`${hero?.firstName ?? 'Omar'} ${hero?.lastName ?? 'Mohammed'}`}
        width="560"
        height="180"
        fetchpriority="high"
      />

      <p class="hero-positioning">
        {(hero?.positioning ?? []).map((line) => <span>{line}</span>)}
      </p>

      <nav class="hero-links" aria-label="Profiles and resume">
        {socialIcons.map((s) => (
          <a class="hero-icon" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill={s.filled ? 'currentColor' : 'none'} stroke={s.filled ? 'none' : 'currentColor'} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={s.svg} />
          </a>
        ))}
        <a class="hero-resume" href={RESUME_URL} target="_blank" rel="noopener noreferrer">Resume</a>
      </nav>
    </div>

    <a href="#projects" class="hero-scroll-cue" aria-label="Scroll to projects">
      <svg class="scroll-cue-arrow" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </a>
  </section>

  <!-- ============ PROJECTS ============ -->
  <section id="projects" class="content-section content-section--wide reveal">
    <div class="content-inner content-inner--wide">
      <h2 class="section-heading">Projects</h2>

      {featuredProject && (
        <article class="featured-card">
          {featuredProject.status && <span class="featured-tag">{featuredProject.status}</span>}
          <h3 class="featured-title">{featuredProject.name}</h3>
          <p class="featured-one-liner">{featuredProject.oneLiner}</p>
          <p class="project-tech">{featuredProject.tech.join('  ·  ')}</p>
        </article>
      )}

      <div class="work-grid">
        {projects.map((p) => (
          <button class="project-card" data-open={p.id} aria-label={`${p.name} — open details`}>
            <div class="card-media" data-media={p.model3d ? '3d' : 'video'}>
              {p.model3d ? (
                <PCBViewer
                  src={p.model3d}
                  alt={`${p.name} 3D model`}
                  fallback={p.poster}
                  interactive={false}
                  cameraOrbit="35deg 60deg 0.22m"
                />
              ) : p.video ? (
                <video
                  class="card-video"
                  src={p.video}
                  poster={p.poster}
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  autoplay
                  aria-label={`${p.name} demo video`}
                ></video>
              ) : p.poster ? (
                <img class="card-video" src={p.poster} alt={`${p.name} preview`} />
              ) : null}
              <div class="card-overlay">
                <h3 class="card-name">{p.name}</h3>
                <span class="card-cue" aria-hidden="true">View<span class="cue-arrow">↗</span></span>
              </div>
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ SKILLS ============ -->
  <section id="skills" class="content-section content-section--wide reveal">
    <div class="content-inner content-inner--wide">
      <h2 class="section-heading">Skills</h2>

      <div class="skills-list">
        {skills.map((s) => (
          <div class="skill-group">
            <h3 class="skill-cat">{s.label}</h3>
            <p class="skill-items">
              {s.items.map((i, idx) => (
                <>
                  {idx > 0 && <span class="skill-sep" aria-hidden="true">,</span>}
                  <span class="skill-item">{i}</span>
                </>
              ))}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PROJECT MODALS ============ -->
  {projects.map((p) => (
    <dialog class="project-modal" id={`modal-${p.id}`} aria-labelledby={`modal-${p.id}-title`}>
      <div class="modal-inner">
        <div class="modal-head">
          <div class="modal-head-text">
            <h3 id={`modal-${p.id}-title`} class="modal-title">{p.name}</h3>
            <p class="modal-subtitle">{p.subtitle}</p>
          </div>
          <button class="modal-close" data-close aria-label="Close (Esc)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"/>
              <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>

        {p.model3d ? (
          <div class="modal-media">
            <PCBViewer src={p.model3d} alt={`${p.name} 3D model`} fallback={p.poster} />
          </div>
        ) : p.video ? (
          <div class="modal-media">
            <video
              class="modal-video"
              src={p.video}
              poster={p.poster}
              muted
              loop
              playsinline
              preload="metadata"
              autoplay
            ></video>
          </div>
        ) : p.poster ? (
          <div class="modal-media">
            <img class="modal-video" src={p.poster} alt={`${p.name} preview`} />
          </div>
        ) : null}

        {p.body.map((para) => <p class="modal-body">{para}</p>)}

        <div class="modal-specs">
          {p.specs.map(([k, v]) => (
            <div class="spec-row">
              <span class="spec-key">{k}</span>
              <span class="spec-val">{v}</span>
            </div>
          ))}
        </div>

        {p.github && (
          <div class="modal-foot">
            <a class="cta-primary" href={p.github} target="_blank" rel="noopener noreferrer">
              View on GitHub
              <span class="cta-arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        )}
      </div>
    </dialog>
  ))}
</BaseLayout>

<style>
  :root {
    --content-max: 920px;
    --content-wide: 1100px;
  }

  .content-section {
    padding: 7rem var(--gutter) 0;
  }

  .content-inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .content-inner--wide {
    max-width: var(--content-wide);
  }

  /* ============ SECTION HEADINGS (Fraunces, prominent) ============ */
  .section-heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 4vw, 2.75rem);
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin: 0 0 2.25rem;
    line-height: 1.05;
  }

  /* ============ HERO ============ */
  .hero {
    position: relative;
    /* Cap the hero so it doesn't stretch on very tall / zoomed-out viewports,
       which would leave a large empty band between the centered content and
       the projects section below. */
    min-height: min(100vh, 860px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 6rem var(--gutter) 6rem;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: var(--content-max);
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-signature {
    width: min(560px, 84vw);
    height: auto;
    display: block;
    margin-bottom: 2rem;
    clip-path: inset(0 100% 0 0);
    animation: sign-draw 1.4s cubic-bezier(0.65, 0, 0.35, 1) 0.25s forwards;
  }

  @keyframes sign-draw {
    to { clip-path: inset(0 0 0 0); }
  }

  .hero-positioning {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin: 0;
    opacity: 0;
    animation: hero-fade 0.8s ease 1.1s forwards;
  }

  .hero-positioning span { display: block; }
  .hero-positioning span + span { margin-top: 0.4rem; }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 2rem;
    opacity: 0;
    animation: hero-fade 0.8s ease 1.3s forwards;
  }

  .hero-icon {
    color: var(--color-text-primary);
    display: inline-flex;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .hero-icon:hover {
    color: var(--color-green-primary);
    transform: translateY(-2px);
  }

  .hero-resume {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--color-text-muted);
    padding-bottom: 1px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .hero-resume:hover {
    color: var(--color-green-primary);
    border-bottom-color: var(--color-green-primary);
  }

  @keyframes hero-fade {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-scroll-cue {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--color-text-muted);
    z-index: 2;
    transition: color 0.2s ease;
  }
  .hero-scroll-cue:hover { color: var(--color-green-primary); }
  .scroll-cue-arrow { animation: scroll-bounce 1.8s ease-in-out infinite; display: block; }

  @keyframes scroll-bounce {
    0%, 100% { transform: translateY(0); opacity: 0.55; }
    50% { transform: translateY(5px); opacity: 1; }
  }

  /* ============ FEATURED CARD ============ */
  .featured-card {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
    padding: 1.85rem 2rem 1.9rem;
    margin-bottom: 1.5rem;
    border-left: 3px solid var(--color-green-primary);
  }

  .featured-tag {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: var(--color-green-primary);
    margin-bottom: 0.6rem;
  }

  .featured-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.5rem, 2.6vw, 1.95rem);
    color: var(--color-text-primary);
    margin: 0 0 0.55rem;
    line-height: 1.15;
  }

  .featured-one-liner {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 1rem;
    max-width: 68ch;
  }

  .project-tech {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
    letter-spacing: 0.01em;
  }

  /* ============ PROJECT TILES ============ */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .project-card {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    overflow: hidden;
    cursor: pointer;
    font: inherit;
    color: inherit;
    text-align: left;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .project-card:hover {
    border-color: var(--color-text-muted);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .project-card:focus-visible {
    outline: 2px solid var(--color-green-primary);
    outline-offset: 2px;
  }

  .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-bg-secondary);
  }

  .card-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* model-viewer fills the tile uniformly (same area as the video tiles) */
  .card-media :global(.viewer-container),
  .card-media :global(.pcb-viewer) {
    width: 100%;
    height: 100%;
  }
  .card-media :global(.pcb-viewer) {
    border: none;
    border-radius: 0;
    background: var(--color-bg-secondary);
  }

  /* Name overlay + click affordance */
  .card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 1.2rem 1.35rem;
    background: linear-gradient(to top, rgba(20, 26, 27, 0.72) 0%, rgba(20, 26, 27, 0.25) 38%, transparent 65%);
    pointer-events: none;
  }

  .card-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
    line-height: 1.12;
    color: #FAF9F6;
    margin: 0;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.25);
  }

  .card-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.55rem;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    color: rgba(250, 249, 246, 0.9);
    opacity: 0.85;
    transform: translateY(2px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .cue-arrow { font-size: 0.9em; }
  .project-card:hover .card-cue { opacity: 1; transform: translateY(0); }

  /* ============ SKILLS (editorial big-type list) ============ */
  .skills-list {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .skill-group {
    display: grid;
    grid-template-columns: minmax(180px, 0.7fr) 2fr;
    gap: 1.5rem 2.5rem;
    align-items: baseline;
  }

  .skill-cat {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    line-height: 1.1;
    color: var(--color-text-primary);
    margin: 0;
  }

  .skill-items {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    line-height: 1.85;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .skill-sep { color: var(--color-text-muted); margin-right: 0.15rem; }

  /* ============ REVEAL ON SCROLL ============ */
  .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal.is-visible { opacity: 1; transform: translateY(0); }

  /* ============ MODAL ============ */
  .project-modal {
    border: none;
    background: transparent;
    padding: 0;
    margin: auto;
    inset: 0;
    max-width: 760px;
    width: calc(100vw - 2rem);
    max-height: calc(100vh - 2rem);
    border-radius: 10px;
    color: var(--color-text-primary);
  }
  .project-modal::backdrop {
    background: rgba(20, 22, 20, 0.38);
    backdrop-filter: blur(2px);
  }
  .project-modal[open] { animation: modal-in 0.2s ease; }

  @keyframes modal-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .modal-inner {
    position: relative;
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--color-green-primary);
    border-radius: 10px;
    padding: 1.85rem;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
  }

  .modal-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .modal-head-text { flex: 1 1 auto; min-width: 0; }

  .modal-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.6rem, 3vw, 2rem);
    margin: 0 0 0.25rem;
    line-height: 1.12;
    letter-spacing: -0.01em;
  }

  .modal-subtitle {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .modal-close {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border: 1px solid var(--color-border);
    background: transparent;
    border-radius: 8px;
    color: var(--color-text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .modal-close:hover {
    color: var(--color-text-primary);
    border-color: var(--color-text-primary);
  }

  .modal-media {
    width: 100%;
    background: var(--color-bg-secondary);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 1.25rem;
  }

  .modal-video {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .modal-body {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-text-primary);
    line-height: 1.7;
    margin: 0 0 0.9rem;
  }

  .modal-specs {
    margin-top: 1rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }

  .spec-row {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 1rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-sans);
    font-size: 0.875rem;
  }
  .spec-row:last-child { border-bottom: none; }
  .spec-key { color: var(--color-text-muted); }
  .spec-val { color: var(--color-text-primary); }

  .modal-foot {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-green-primary);
    background: transparent;
    border: 1px solid var(--color-green-primary);
    border-radius: var(--radius-md);
    padding: 0.55rem 1rem;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .cta-primary:hover {
    background: var(--color-green-primary);
    color: #FAF9F6;
  }
  .cta-arrow { font-size: 0.85em; }

  /* ============ CURSOR RESTORE OVER MODAL ============ */
  body.modal-open,
  body.modal-open * { cursor: auto !important; }
  body.modal-open .custom-cursor { display: none !important; }
  body.modal-open model-viewer,
  body.modal-open model-viewer * { cursor: grab !important; }

  /* ============ TABLET / MOBILE ============ */
  /* Keep the 2-up grid down through tablets; single column only on phones,
     so portrait tablets don't get oversized full-width 4:3 tiles. */
  @media (max-width: 640px) {
    .work-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .content-section { padding-top: 5rem; }
    .hero-signature { width: min(420px, 86vw); }
    .hero-positioning { font-size: 1rem; }
    .featured-card { padding: 1.4rem 1.4rem; }
    .modal-inner { padding: 1.3rem; }
    .spec-row { grid-template-columns: 1fr; gap: 0; }
  }

  @media (max-width: 560px) {
    .skill-group { grid-template-columns: 1fr; gap: 0.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-modal[open] { animation: none; }
    .scroll-cue-arrow { animation: none; }
    .hero-signature { clip-path: none; animation: none; }
    .hero-positioning, .hero-links { opacity: 1; animation: none; }
    .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  function wireModals() {
    document.querySelectorAll<HTMLElement>('[data-open]').forEach((trigger) => {
      const target = trigger.getAttribute('data-open');
      if (!target) return;
      const dlg = document.getElementById(`modal-${target}`) as HTMLDialogElement | null;
      if (!dlg) return;
      const open = () => {
        if (typeof dlg.showModal === 'function') dlg.showModal();
        else dlg.setAttribute('open', '');
        document.body.classList.add('modal-open');
      };
      trigger.addEventListener('click', open);
    });

    document.querySelectorAll<HTMLDialogElement>('.project-modal').forEach((dlg) => {
      const onClose = () => document.body.classList.remove('modal-open');
      dlg.addEventListener('close', onClose);
      dlg.addEventListener('cancel', onClose);
      dlg.querySelectorAll<HTMLButtonElement>('[data-close]').forEach((btn) => {
        btn.addEventListener('click', () => dlg.close());
      });
      dlg.addEventListener('click', (e) => {
        const inner = dlg.querySelector('.modal-inner');
        if (inner && !inner.contains(e.target as Node)) dlg.close();
      });
    });
  }

  function wireReveal() {
    if (!('IntersectionObserver' in window)) {
      document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -10% 0px' }
    );
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  }

  wireModals();
  wireReveal();
  document.addEventListener('astro:page-load', () => {
    wireModals();
    wireReveal();
  });
</script>
