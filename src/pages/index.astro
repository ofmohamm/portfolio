---
import BaseLayout from '../layouts/BaseLayout.astro';
import InteractiveBackground from '../components/InteractiveBackground';
import PCBViewer from '../components/PCBViewer.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

// All content below is managed through the dashboard at /keystatic.
const reader = createReader(process.cwd(), keystaticConfig);

const [hero, featuredProject, skillsData, seo, projectEntries] = await Promise.all([
  reader.singletons.hero.read(),
  reader.singletons.featured.read(),
  reader.singletons.skills.read(),
  reader.singletons.seo.read(),
  reader.collections.projects.all(),
]);

// Shape projects to match the template, sorted by display order.
const projects = projectEntries
  .map(({ slug, entry }) => ({
    id: slug,
    name: entry.name,
    subtitle: entry.subtitle,
    oneLiner: entry.oneLiner,
    order: entry.order,
    poster: entry.poster ?? undefined,
    model3d: entry.mediaType === '3d' ? entry.model3d ?? undefined : undefined,
    video: entry.mediaType === 'video' ? entry.video ?? undefined : undefined,
    tech: entry.tech,
    github: entry.github ?? undefined,
    body: entry.body,
    // Keystatic stores specs as [{key,value}]; the template wants entries pairs.
    specs: entry.specs.map((s) => [s.key, s.value] as const),
    // Pull a 4-digit year out of the subtitle for the card meta line, if present.
    year: (entry.subtitle.match(/\b(19|20)\d{2}\b/) ?? [])[0],
  }))
  .sort((a, b) => a.order - b.order);

const skills = (skillsData?.groups ?? []).map((g) => ({
  label: g.label,
  items: g.items,
}));

// Social + resume links — rendered inline in the hero and mirrored in the footer.
const social = [
  { href: 'https://github.com/ofmohamm', label: 'GitHub', external: true },
  { href: 'https://linkedin.com/in/ofmohammed', label: 'LinkedIn', external: true },
  { href: 'mailto:mail.omarmohammed@gmail.com', label: 'Email', external: false },
  {
    href: 'https://drive.google.com/file/d/1-0OkidhFCiwY4Qzrx7l75aHpLJc4_KkF/view?usp=sharing',
    label: 'Résumé',
    external: true,
  },
];
---

<BaseLayout
  title={seo?.title ?? 'Omar Mohammed — FPGA, embedded firmware, PCB design'}
  description={seo?.description ?? 'Hardware design focused EE student at Syracuse. FPGA accelerators (Vivado, SystemVerilog, VHDL), embedded firmware (C/C++, LoRaWAN), and PCB design (KiCad).'}
>
  <!-- ============ HERO ============ -->
  <section id="hero" class="snap-section hero">
    <InteractiveBackground client:load />

    <div class="hero-inner">
      <img
        class="hero-signature"
        src="/images/logo.png"
        alt={`${hero?.firstName ?? 'Omar'} ${hero?.lastName ?? 'Mohammed'}`}
        width="560"
        height="180"
        fetchpriority="high"
      />

      <p class="hero-positioning">
        {(hero?.positioning ?? []).map((line) => <span>{line}</span>)}
      </p>

      <nav class="hero-links" aria-label="Profiles and resume">
        {social.map((s) => (
          <a
            class="hero-link"
            href={s.href}
            target={s.external ? '_blank' : undefined}
            rel={s.external ? 'noopener noreferrer' : undefined}
          >
            {s.label}
            {s.external && <span class="link-arrow" aria-hidden="true">↗</span>}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- ============ PROJECTS ============ -->
  <section id="projects" class="content-section content-section--wide reveal">
    <div class="content-inner content-inner--wide">
      <h2 class="section-label">Projects</h2>

      {featuredProject && (
        <article class="featured-card">
          <div class="project-title-row">
            <h3 class="featured-title">{featuredProject.name}</h3>
            {featuredProject.status && (
              <span class="tag-in-progress">{featuredProject.status}</span>
            )}
          </div>
          <p class="featured-one-liner">{featuredProject.oneLiner}</p>
          <p class="project-tech">{featuredProject.tech.join(' · ')}</p>
        </article>
      )}

      <div class="work-grid">
        {projects.map((p) => (
          <article class="project-card" data-open={p.id} role="button" tabindex="0" aria-label={`${p.name} — open details`}>
            <div class="project-media-wrap" data-media={p.model3d ? '3d' : 'video'}>
              {p.model3d ? (
                <PCBViewer
                  src={p.model3d}
                  alt={`${p.name} 3D model`}
                  fallback={p.poster}
                  disableZoom
                  hint="Drag to rotate"
                  cameraOrbit="45deg 55deg 0.2m"
                  minCameraOrbit="auto auto 0.18m"
                  maxCameraOrbit="auto auto 0.45m"
                />
              ) : p.video ? (
                <video
                  class="project-video"
                  src={p.video}
                  poster={p.poster}
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  autoplay
                  aria-label={`${p.name} demo video`}
                ></video>
              ) : p.poster ? (
                <img class="project-video" src={p.poster} alt={`${p.name} preview`} />
              ) : null}
            </div>

            <div class="project-body">
              <div class="project-title-row">
                <h3 class="project-title">{p.name}</h3>
                {p.year && <span class="project-year">{p.year}</span>}
              </div>
              <p class="project-one-liner">{p.oneLiner}</p>
              <p class="project-tech">{p.tech.join(' · ')}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ SKILLS ============ -->
  <section id="skills" class="content-section reveal">
    <div class="content-inner">
      <h2 class="section-label">Skills</h2>

      <div class="circuit">
        {skills.map((s) => (
          <div class="circuit-group">
            <div class="circuit-node">
              <span class="node-dot" aria-hidden="true"></span>
              <span class="node-label">{s.label}</span>
              <span class="node-wire" aria-hidden="true"></span>
            </div>
            <ul class="circuit-traces">
              {s.items.map((i) => (
                <li class="trace">{i}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PROJECT MODALS ============ -->
  {projects.map((p) => (
    <dialog class="project-modal" id={`modal-${p.id}`} aria-labelledby={`modal-${p.id}-title`}>
      <div class="modal-inner">
        <div class="modal-head">
          <div class="modal-head-text">
            <h3 id={`modal-${p.id}-title`} class="modal-title">{p.name}</h3>
            <p class="modal-subtitle">{p.subtitle}</p>
          </div>
          <button class="modal-close" data-close aria-label="Close (Esc)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"/>
              <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>

        {p.model3d ? (
          <div class="modal-media">
            <PCBViewer src={p.model3d} alt={`${p.name} 3D model`} fallback={p.poster} />
          </div>
        ) : p.video ? (
          <div class="modal-media">
            <video
              class="modal-video"
              src={p.video}
              poster={p.poster}
              muted
              loop
              playsinline
              preload="metadata"
              autoplay
            ></video>
          </div>
        ) : p.poster ? (
          <div class="modal-media">
            <img class="modal-video" src={p.poster} alt={`${p.name} preview`} />
          </div>
        ) : null}

        {p.body.map((para) => <p class="modal-body">{para}</p>)}

        <div class="modal-specs">
          {p.specs.map(([k, v]) => (
            <div class="spec-row">
              <span class="spec-key">{k}</span>
              <span class="spec-val">{v}</span>
            </div>
          ))}
        </div>

        <div class="modal-foot">
          {p.github ? (
            <a class="cta-primary" href={p.github} target="_blank" rel="noopener noreferrer">
              View on GitHub
              <span class="cta-arrow" aria-hidden="true">↗</span>
            </a>
          ) : <span></span>}
          <span class="modal-esc-hint">esc to close</span>
        </div>
      </div>
    </dialog>
  ))}
</BaseLayout>

<style>
  :root {
    --content-max: 920px;
    --content-wide: 1100px;
  }

  .content-section {
    padding: 7rem var(--gutter) 0;
  }

  .content-inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .content-inner--wide {
    max-width: var(--content-wide);
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    margin: 0 0 2.25rem;
  }

  /* ============ HERO ============ */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 6rem var(--gutter) 6rem;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: var(--content-max);
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-signature {
    width: min(560px, 84vw);
    height: auto;
    display: block;
    margin-bottom: 2rem;
    /* Draw-on: reveal the signature left-to-right, like it's being written. */
    clip-path: inset(0 100% 0 0);
    animation: sign-draw 1.4s cubic-bezier(0.65, 0, 0.35, 1) 0.25s forwards;
  }

  @keyframes sign-draw {
    to { clip-path: inset(0 0 0 0); }
  }

  .hero-positioning {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin: 0;
    opacity: 0;
    animation: hero-fade 0.8s ease 1.1s forwards;
  }

  .hero-positioning span {
    display: block;
  }

  .hero-positioning span + span {
    margin-top: 0.4rem;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 2rem;
    opacity: 0;
    animation: hero-fade 0.8s ease 1.3s forwards;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .hero-link:hover {
    color: var(--color-green-primary);
    border-bottom-color: var(--color-green-primary);
  }

  .link-arrow {
    font-size: 0.8em;
    color: var(--color-text-muted);
    transition: color 0.15s ease;
  }

  .hero-link:hover .link-arrow {
    color: var(--color-green-primary);
  }

  @keyframes hero-fade {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ============ FEATURED CARD ============ */
  .featured-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
    padding: 1.75rem 2rem;
    margin-bottom: 1.5rem;
  }

  .project-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .featured-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.4rem;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.25;
  }

  .featured-one-liner {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 0.9rem;
    max-width: 64ch;
  }

  .tag-in-progress {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-green-primary);
    white-space: nowrap;
  }

  .project-tech {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
    letter-spacing: 0.01em;
  }

  /* ============ PROJECT GRID ============ */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .project-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
    overflow: hidden;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .project-card:hover {
    border-color: var(--color-text-muted);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .project-card:focus-visible {
    outline: 2px solid var(--color-green-primary);
    outline-offset: 2px;
  }

  .project-media-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--color-bg-secondary);
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    position: relative;
  }

  .project-media-wrap[data-media='3d'] {
    aspect-ratio: 16 / 10;
  }

  /* In-card model-viewer overrides */
  .project-media-wrap :global(.viewer-container) {
    width: 100%;
    height: 100%;
  }

  .project-media-wrap :global(.pcb-viewer) {
    width: 100%;
    height: 100%;
    border-radius: 0;
    border: none;
    background: var(--color-bg-secondary);
    cursor: grab;
    touch-action: pan-y;
  }

  .project-media-wrap :global(.viewer-hint) {
    position: absolute;
    bottom: 0.5rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    background: rgba(250, 249, 246, 0.85);
    backdrop-filter: blur(4px);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-secondary);
    pointer-events: none;
  }

  .project-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .project-body {
    padding: 1.25rem 1.4rem 1.4rem;
    flex: 1;
  }

  .project-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.075rem;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .project-year {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .project-one-liner {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0 0 0.85rem;
  }

  /* ============ SKILLS — CIRCUIT ============ */
  .circuit {
    display: flex;
    flex-direction: column;
  }

  .circuit-group {
    display: grid;
    grid-template-columns: minmax(150px, 210px) 1fr;
    align-items: center;
    gap: 0;
    padding: 1.85rem 0;
    border-top: 1px solid var(--color-border);
  }

  .circuit-group:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .circuit-node {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-right: 0;
  }

  .node-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-green-primary);
    box-shadow: 0 0 0 3px var(--color-green-bg);
    flex-shrink: 0;
  }

  .node-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .node-wire {
    flex: 1;
    height: 1px;
    min-width: 1rem;
    background: var(--color-border);
  }

  .circuit-traces {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.6rem;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  /* Vertical bus running down the left edge of the skill list. */
  .circuit-traces::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    bottom: 0.62em;
    width: 1px;
    background: var(--color-border);
  }

  .trace {
    position: relative;
    font-family: var(--font-sans);
    font-size: 0.96rem;
    color: var(--color-text-primary);
    line-height: 1.25;
  }

  /* Horizontal stub from the bus to the skill name. */
  .trace::before {
    content: '';
    position: absolute;
    left: -1.6rem;
    top: 50%;
    width: 1.15rem;
    height: 1px;
    background: var(--color-border);
  }

  /* Solder-dot junction where the stub meets the bus. */
  .trace::after {
    content: '';
    position: absolute;
    left: calc(-1.6rem - 2px);
    top: 50%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-bg-primary);
    border: 1px solid var(--color-text-muted);
    transform: translateY(-50%);
  }

  /* ============ REVEAL ON SCROLL ============ */
  .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ============ MODAL ============ */
  .project-modal {
    border: none;
    background: transparent;
    padding: 0;
    margin: auto;
    inset: 0;
    max-width: 760px;
    width: calc(100vw - 2rem);
    max-height: calc(100vh - 2rem);
    border-radius: 8px;
    color: var(--color-text-primary);
  }

  .project-modal::backdrop {
    background: rgba(20, 22, 20, 0.38);
    backdrop-filter: blur(2px);
  }

  .project-modal[open] {
    animation: modal-in 0.2s ease;
  }

  @keyframes modal-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .modal-inner {
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.75rem;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
  }

  .modal-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .modal-head-text { flex: 1 1 auto; min-width: 0; }

  .modal-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.4rem;
    margin: 0 0 0.25rem;
    line-height: 1.2;
  }

  .modal-subtitle {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .modal-close {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border: 1px solid var(--color-border);
    background: transparent;
    border-radius: 8px;
    color: var(--color-text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .modal-close:hover {
    color: var(--color-text-primary);
    border-color: var(--color-text-primary);
  }

  .modal-media {
    width: 100%;
    background: var(--color-bg-secondary);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 1.25rem;
  }

  .modal-video {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .modal-body {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-text-primary);
    line-height: 1.7;
    margin: 0 0 0.9rem;
  }

  .modal-specs {
    margin-top: 1rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }

  .spec-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .spec-row:last-child { border-bottom: none; }
  .spec-key { color: var(--color-text-muted); }
  .spec-val { color: var(--color-text-primary); }

  .modal-foot {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .modal-esc-hint {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-green-primary);
    background: transparent;
    border: 1px solid var(--color-green-primary);
    border-radius: var(--radius-md);
    padding: 0.55rem 1rem;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .cta-primary:hover {
    background: var(--color-green-primary);
    color: #FAF9F6;
  }

  .cta-arrow {
    font-size: 0.85em;
  }

  /* ============ CURSOR RESTORE OVER MODAL ============ */
  body.modal-open,
  body.modal-open * {
    cursor: auto !important;
  }
  body.modal-open .custom-cursor {
    display: none !important;
  }
  body.modal-open model-viewer,
  body.modal-open model-viewer * {
    cursor: grab !important;
  }

  /* ============ TABLET ============ */
  @media (max-width: 820px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ============ MOBILE ============ */
  @media (max-width: 640px) {
    .content-section {
      padding-top: 5rem;
    }
    .hero-signature {
      width: min(420px, 86vw);
    }
    .hero-positioning { font-size: 1rem; }
    .hero-links { gap: 1.15rem; }
    .featured-card { padding: 1.4rem 1.4rem; }
    .featured-title { font-size: 1.25rem; }
    .project-title-row {
      align-items: flex-start;
    }
    .modal-inner { padding: 1.25rem; }
    .spec-row { grid-template-columns: 1fr; gap: 0; }
  }

  /* Circuit collapses to a simple stacked tree on narrow screens. */
  @media (max-width: 560px) {
    .circuit-group {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 0.9rem;
      padding: 1.5rem 0;
    }
    .node-wire { display: none; }
    .circuit-traces { padding-left: 1.1rem; }
    .trace::before { left: -1.1rem; width: 0.75rem; }
    .trace::after { left: calc(-1.1rem - 2px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-modal[open] { animation: none; }
    .hero-signature {
      clip-path: none;
      animation: none;
    }
    .hero-positioning,
    .hero-links {
      opacity: 1;
      animation: none;
    }
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function wireModals() {
    document.querySelectorAll<HTMLElement>('[data-open]').forEach((trigger) => {
      const target = trigger.getAttribute('data-open');
      if (!target) return;
      const dlg = document.getElementById(`modal-${target}`) as HTMLDialogElement | null;
      if (!dlg) return;

      const open = () => {
        if (typeof dlg.showModal === 'function') {
          dlg.showModal();
        } else {
          dlg.setAttribute('open', '');
        }
        document.body.classList.add('modal-open');
      };

      trigger.addEventListener('click', open);
      // Cards are keyboard-focusable; open on Enter/Space.
      trigger.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open();
        }
      });
    });

    document.querySelectorAll<HTMLDialogElement>('.project-modal').forEach((dlg) => {
      const onClose = () => document.body.classList.remove('modal-open');
      dlg.addEventListener('close', onClose);
      dlg.addEventListener('cancel', onClose);

      dlg.querySelectorAll<HTMLButtonElement>('[data-close]').forEach((btn) => {
        btn.addEventListener('click', () => dlg.close());
      });
      // Click outside content closes
      dlg.addEventListener('click', (e) => {
        const inner = dlg.querySelector('.modal-inner');
        if (inner && !inner.contains(e.target as Node)) {
          dlg.close();
        }
      });
    });
  }

  function wireReveal() {
    if (!('IntersectionObserver' in window)) {
      document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -10% 0px' }
    );
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  }

  function wireInlinePcbScroll() {
    document.querySelectorAll<HTMLElement>(".project-media-wrap[data-media='3d']").forEach((wrap) => {
      if (wrap.dataset.scrollThroughWired === 'true') return;
      wrap.dataset.scrollThroughWired = 'true';

      wrap.addEventListener(
        'wheel',
        (e) => {
          if (wrap.closest('.project-modal')) return;
          e.preventDefault();
          window.scrollBy({
            top: e.deltaY,
            left: e.deltaX,
            behavior: 'auto',
          });
        },
        { passive: false, capture: true }
      );
    });
  }

  wireModals();
  wireReveal();
  wireInlinePcbScroll();
  document.addEventListener('astro:page-load', () => {
    wireModals();
    wireReveal();
    wireInlinePcbScroll();
  });
</script>
</content>
</invoke>
