---
import BaseLayout from '../layouts/BaseLayout.astro';
import ParticleField from '../components/ParticleField.astro';
import { Picture } from 'astro:assets';
import { getEntry } from 'astro:content';
import { loadProjects } from '../lib/projects';
import heroLogo from '../assets/logo.png';

// Content is YAML on disk, read at build time by Astro's content layer.
const [heroEntry, skillsEntry, seoEntry, projects] = await Promise.all([
  getEntry('site', 'hero'),
  getEntry('site', 'skills'),
  getEntry('site', 'seo'),
  loadProjects(),
]);

// The hero signature is flat line art with alpha. A palette PNG encodes it far
// smaller than lossy WebP (12kB vs 37kB), so the source is pre-quantized and
// served as-is. One fixed asset also means the <head> preload and the <img>
// request resolve to the same file, with no double download.
const heroImg = heroLogo;

const hero = heroEntry?.data;
const seo = seoEntry?.data;

// Current work sits above past projects. Empty groups are not rendered.
const projectGroups = [
  { key: 'current', label: 'Current', items: projects.filter((p) => p.status === 'current') },
  { key: 'past', label: 'Previously', items: projects.filter((p) => p.status === 'past') },
].filter((g) => g.items.length > 0);

const skills = (skillsEntry?.data.groups ?? []).map((g) => ({
  label: g.label,
  items: g.items,
}));

// Profiles as consistent thin line icons (matching the monoline logo).
const socialIcons = [
  {
    href: 'https://github.com/ofmohamm',
    label: 'GitHub',
    svg: `<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>`,
  },
  {
    href: 'https://linkedin.com/in/ofmohammed',
    label: 'LinkedIn',
    svg: `<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>`,
  },
  {
    href: 'mailto:mail.omarmohammed@gmail.com',
    label: 'Email',
    svg: `<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>`,
  },
];
---

<BaseLayout
  preloadImage={heroImg.src}
  title={seo?.title ?? 'Omar Mohammed — FPGA, embedded firmware, PCB design'}
  description={seo?.description ?? 'Hardware design focused EE student at Syracuse. FPGA accelerators (Vivado, SystemVerilog, VHDL), embedded firmware (C/C++, LoRaWAN), and PCB design (KiCad).'}
>
  <!-- Links shared before projects had their own pages pointed at
       /#modal-<id>. Forward them before anything paints. -->
  <script is:inline>
    if (location.hash.indexOf('#modal-') === 0) location.replace('/projects/' + encodeURIComponent(location.hash.slice(7)) + '/');
  </script>

  <!-- ============ HERO ============ -->
  <section id="hero" class="snap-section hero">
    <ParticleField />

    <div class="hero-inner">
      <!--
        The signature is the visual H1. The name is carried as real text for
        crawlers and screen readers, and the image is marked decorative so the
        name is not announced twice.
      -->
      <h1 class="hero-h1">
        <span class="sr-only">{`${hero?.firstName ?? 'Omar'} ${hero?.lastName ?? 'Mohammed'}`}</span>
      </h1>
      <img
        class="hero-signature"
        src={heroImg.src}
        alt=""
        aria-hidden="true"
        width={heroImg.width}
        height={heroImg.height}
        fetchpriority="high"
        decoding="async"
      />

      <p class="hero-positioning">
        {(hero?.positioning ?? []).map((line) => (
          // Glue "@" and "|" to the word before them, so a wrapped line never starts with one.
          <span>{line.replace(/ ([@|]) /g, '\u00A0$1 ')}</span>
        ))}
      </p>

      <nav class="hero-links" aria-label="Profiles and resume">
        {socialIcons.map((s) => (
          <a class="hero-icon" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={s.svg} />
          </a>
        ))}
      </nav>
    </div>

    <a href="#projects" class="hero-scroll-cue" aria-label="Scroll to projects">
      <svg class="scroll-cue-arrow" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </a>
  </section>

  <!-- ============ PROJECTS ============ -->
  <section id="projects" class="content-section content-section--wide reveal">
    <div class="content-inner content-inner--wide">
      <h2 class="section-heading">Projects</h2>

      {projectGroups.map((g) => (
        <div class={`project-group project-group--${g.key}`}>
          <div class={`work-grid work-grid--${g.key}`}>
            {g.items.map((p) => (
              <a class="project-card" id={p.id} href={p.href} data-astro-prefetch="viewport" aria-label={`${p.name}, view project`}>
                <div class="card-media" data-media="image">
                  {p.cover && (
                    <!-- The photo alone is named for the page transition, not
                         the card, so the title and gradient don't stretch. -->
                    <Picture
                      class="card-video"
                      style={`view-transition-name: cover-${p.id}`}
                      data-vt={`cover-${p.id}`}
                      src={p.cover}
                      alt={`${p.name} preview`}
                      widths={[480, 800, 1200]}
                      sizes="(max-width: 768px) 100vw, 540px"
                      formats={['avif', 'webp']}
                      fallbackFormat="webp"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <div class="card-overlay">
                    {p.org && <span class="card-org">{p.org}{p.status === 'current' && ' · In progress'}</span>}
                    <h3 class="card-name">{p.name}</h3>
                    <span class="card-cue" aria-hidden="true">View details</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ SKILLS ============ -->
  <section id="skills" class="content-section content-section--wide reveal">
    <div class="content-inner content-inner--wide">
      <h2 class="section-heading">Skills</h2>

      <div class="skills-list">
        {skills.map((s) => (
          <div class="skill-group">
            <h3 class="skill-cat">{s.label}</h3>
            <p class="skill-items">
              {s.items.map((i, idx) => (
                <>{idx > 0 && <span class="skill-sep" aria-hidden="true">, </span>}<span class="skill-item">{i}</span></>
              ))}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  :root {
    --content-max: 920px;
    --content-wide: 1100px;
  }

  .content-section {
    padding: 7rem var(--gutter) 0;
    /* Skip layout and paint for these until they are near the viewport. The
       contain-intrinsic-size keeps the scrollbar honest before they render. */
    content-visibility: auto;
    contain-intrinsic-size: auto 600px;
  }
  /* Except the cards: coming back from a project, the page transition
     captures the restored homepage in its first frame, before a skipped
     section has been brought back, and the cover would have no card to
     land on. */
  #projects { content-visibility: visible; }

  .content-inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .content-inner--wide {
    max-width: var(--content-wide);
  }

  /* ============ SECTION HEADINGS (Fraunces, prominent) ============ */
  .section-heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 4vw, 2.75rem);
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin: 0 0 2.25rem;
    line-height: 1.05;
  }

  /* ============ HERO ============ */
  .hero {
    position: relative;
    /* Cap the hero so it doesn't stretch on very tall / zoomed-out viewports,
       which would leave a large empty band between the centered content and
       the projects section below. */
    min-height: min(100vh, 860px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 6rem var(--gutter) 6rem;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: var(--content-max);
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-h1 {
    margin: 0;
    padding: 0;
    line-height: 0;
  }

  .hero-signature {
    width: min(560px, 84vw);
    height: auto;
    display: block;
    margin-bottom: 2rem;
    clip-path: inset(0 100% 0 0);
    animation: sign-draw 1.4s cubic-bezier(0.65, 0, 0.35, 1) 0.25s forwards;
  }

  @keyframes sign-draw {
    to { clip-path: inset(0 0 0 0); }
  }

  .hero-positioning {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin: 0;
    opacity: 0;
    animation: hero-fade 0.8s ease 1.1s forwards;
  }

  .hero-positioning span { display: block; text-wrap: balance; }
  .hero-positioning span + span { margin-top: 0.4rem; }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 2rem;
    opacity: 0;
    animation: hero-fade 0.8s ease 1.3s forwards;
  }

  .hero-icon {
    color: var(--color-text-primary);
    display: inline-flex;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .hero-icon:hover {
    color: var(--color-green-primary);
    transform: translateY(-2px);
  }

  @keyframes hero-fade {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-scroll-cue {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--color-text-muted);
    z-index: 2;
    transition: color 0.2s ease;
  }
  .hero-scroll-cue:hover { color: var(--color-green-primary); }
  .scroll-cue-arrow { animation: scroll-bounce 1.8s ease-in-out infinite; display: block; }

  @keyframes scroll-bounce {
    0%, 100% { transform: translateY(0); opacity: 0.55; }
    50% { transform: translateY(5px); opacity: 1; }
  }

  /* ============ FEATURED CARD ============ */

  .project-tech {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
    letter-spacing: 0.01em;
  }

  /* ============ PROJECT GROUPS ============ */
  /* Same gap as inside the grid, so the two groups read as one set of cards. */
  .project-group + .project-group { margin-top: 1.5rem; }

  .card-org {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: rgba(250, 249, 246, 0.85);
    margin-bottom: 0.35rem;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.3);
  }

  /* ============ PROJECT TILES ============ */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .project-card {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    overflow: hidden;
    cursor: pointer;
    font: inherit;
    color: inherit;
    text-align: left;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .project-card:hover {
    border-color: var(--color-text-muted);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .project-card:focus-visible {
    outline: 2px solid var(--color-green-primary);
    outline-offset: 2px;
  }

  .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-bg-secondary);
  }

  .card-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* model-viewer fills the tile uniformly (same area as the video tiles) */
  .card-media :global(.viewer-container),
  .card-media :global(.pcb-viewer) {
    width: 100%;
    height: 100%;
  }
  .card-media :global(.pcb-viewer) {
    border: none;
    border-radius: 0;
    background: var(--color-bg-secondary);
  }

  /* Name overlay + click affordance */
  .card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 1.2rem 1.35rem;
    background: linear-gradient(to top, rgba(20, 26, 27, 0.72) 0%, rgba(20, 26, 27, 0.25) 38%, transparent 65%);
    pointer-events: none;
  }

  .card-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
    line-height: 1.12;
    color: #FAF9F6;
    margin: 0;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.25);
  }

  .card-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.55rem;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    color: rgba(250, 249, 246, 0.9);
    opacity: 0.85;
    transform: translateY(2px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .cue-arrow { font-size: 0.9em; }
  .project-card:hover .card-cue { opacity: 1; transform: translateY(0); }

  /* "View details" is hover-revealed only where hover exists. The cue stays in
     the layout (opacity, not display), so the title never jumps. Touch devices
     keep it visible because they cannot hover, and keyboard focus reveals it
     the same way hover does. */
  @media (hover: hover) and (pointer: fine) {
    .card-cue {
      opacity: 0;
      transform: translateY(6px);
    }
    .project-card:hover .card-cue,
    .project-card:focus-visible .card-cue {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: reduce) {
    .card-cue,
    .project-card:hover .card-cue,
    .project-card:focus-visible .card-cue {
      transform: none;
    }
  }

  /* ============ SKILLS (editorial big-type list) ============ */
  .skills-list {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .skill-group {
    display: grid;
    grid-template-columns: minmax(180px, 0.7fr) 2fr;
    gap: 1.5rem 2.5rem;
    align-items: baseline;
  }

  .skill-cat {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    line-height: 1.1;
    color: var(--color-text-primary);
    margin: 0;
  }

  .skill-items {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    line-height: 1.85;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .skill-sep { color: var(--color-text-muted); margin-right: 0.15rem; }
  /* Keep each skill on one line ("Bare-Metal", "Intel Quartus"). Wrapping
     happens only at the comma between items. */
  .skill-item { white-space: nowrap; }

  /* ============ REVEAL ON SCROLL ============ */
  .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal.is-visible { opacity: 1; transform: translateY(0); }

  /* ============ TABLET / MOBILE ============ */
  /* Keep the 2-up grid down through tablets; single column only on phones,
     so portrait tablets don't get oversized full-width 4:3 tiles. */
  @media (max-width: 640px) {
    .work-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .content-section { padding-top: 5rem; }
    .hero-signature { width: min(420px, 86vw); }
    .hero-positioning { font-size: 1rem; }
  }

  @media (max-width: 560px) {
    .skill-group { grid-template-columns: 1fr; gap: 0.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue-arrow { animation: none; }
    .hero-signature { clip-path: none; animation: none; }
    .hero-positioning, .hero-links { opacity: 1; animation: none; }
    .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  function wireReveal() {
    if (!('IntersectionObserver' in window)) {
      document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -10% 0px' }
    );
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  }

  wireReveal();
  document.addEventListener('astro:page-load', wireReveal);
</script>
