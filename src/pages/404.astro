---
import ForestLayout from '../layouts/ForestLayout.astro';
---

<ForestLayout title="Page Not Found | Omar Mohammed">
  <div class="nf">
    <p class="big" aria-hidden="true">404</p>
    <h1>Page Not Found</h1>
    <p class="gray">This page doesn't exist or has moved.</p>
    <p class="buttons">
      <a class="button solid" href="/">Go Home</a>
      <button class="button" type="button" data-go-back>Go Back</button>
    </p>
  </div>
</ForestLayout>

<style>
  .nf { text-align: center; padding: 40px 0 20px; }
  .big { font-size: clamp(5rem, 16vw, 8rem); line-height: 1; font-style: italic; font-weight: 500; color: var(--forest); }
  h1 { font-size: 1.4rem; margin-top: 8px; }
  .gray { margin-top: 6px; }
  .buttons { display: flex; gap: 12px; justify-content: center; margin-top: 28px; }
  .button {
    font: inherit; font-size: .9em; cursor: pointer; text-decoration: none;
    border: 1px solid var(--forest); border-radius: 999px; padding: 6px 18px;
    background: transparent; color: var(--forest);
    transition: background-color .15s ease, color .15s ease;
  }
  .button:hover, .button.solid { background: var(--forest); color: var(--paper); }
  .button.solid:hover { background: color-mix(in srgb, var(--forest) 85%, black); }
</style>

<script>
  // "Go Back" only goes back if the previous page was on this site; arriving
  // from an external broken link would otherwise bounce the visitor away.
  document.querySelectorAll<HTMLButtonElement>('[data-go-back]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (history.length > 1 && document.referrer.includes(location.host)) history.back();
      else location.href = '/';
    });
  });
</script>
