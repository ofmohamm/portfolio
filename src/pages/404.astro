---
import BaseLayout from '../layouts/BaseLayout.astro';

// Icons are inline SVG, matching the rest of the site. Avoids pulling in
// lucide-react (and React) for two glyphs.
const ICON_HOME = `<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`;
const ICON_BACK = `<line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>`;
---

<BaseLayout title="Page Not Found | Omar Mohammed">
  <section class="min-h-[70vh] flex items-center justify-center">
    <div class="text-center px-[var(--gutter)]">
      <h1 class="font-heading text-8xl md:text-9xl font-bold text-green-primary mb-4">
        404
      </h1>
      <h2 class="font-heading text-2xl md:text-3xl font-semibold text-text-primary mb-4">
        Page Not Found
      </h2>
      <p class="text-text-secondary text-lg mb-8 max-w-md mx-auto">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 bg-green-primary text-white font-medium rounded-lg hover:bg-green-hover transition-all"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICON_HOME} />
          Go Home
        </a>
        <button
          data-go-back
          class="inline-flex items-center gap-2 px-6 py-3 border-2 border-green-primary text-green-primary font-medium rounded-lg hover:bg-green-primary hover:text-white transition-all"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICON_BACK} />
          Go Back
        </button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // "Go back" is only useful if there is somewhere on this site to go back to.
  // Arriving from an external broken link would otherwise bounce the visitor
  // straight off the site.
  document.querySelectorAll<HTMLButtonElement>('[data-go-back]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (history.length > 1 && document.referrer.includes(location.host)) history.back();
      else location.href = '/';
    });
  });
</script>
