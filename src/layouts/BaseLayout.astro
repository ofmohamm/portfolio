---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Hashed URLs for the two self-hosted font subsets, so they can be preloaded.
// @font-face declarations live in global.css.
import newsreaderUrl from '../assets/fonts/newsreader-latin.woff2?url';
import schibstedUrl from '../assets/fonts/schibsted-grotesk-latin.woff2?url';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Optional above-the-fold image to preload (already-optimized URL). */
  preloadImage?: string;
}

const {
  title,
  preloadImage,
  description = "Hardware design focused EE student at Syracuse University. FPGA accelerators (Vivado, SystemVerilog, VHDL), embedded firmware (C/C++, LoRaWAN), and PCB design (KiCad).",
  image = "/og-image.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://omarmohammed.co');
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <!-- Drops the no-js class immediately so CSS can target the no-JS case.
         Inline and ~60 bytes; no network cost. -->
    <script is:inline>document.documentElement.classList.remove('no-js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon — the "mo" logo mark, transparent -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!--
      Fonts are self-hosted (see global.css). No third-party origin, no
      render-blocking stylesheet from fonts.googleapis.com.
    -->
    <link rel="preload" href={newsreaderUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={schibstedUrl} as="font" type="font/woff2" crossorigin />

    <!-- Above-the-fold image paints first; start it before the parser gets there. -->
    {preloadImage && <link rel="preload" href={preloadImage} as="image" />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Omar Mohammed",
      "jobTitle": "Electrical Engineering Student",
      "description": "Hardware design focused EE student. FPGA accelerators, embedded firmware, PCB design.",
      "knowsAbout": ["FPGA", "RTL", "SystemVerilog", "VHDL", "Embedded Systems", "PCB Design", "KiCad", "LoRaWAN", "C", "C++"],
      "affiliation": {
        "@type": "CollegeOrUniversity",
        "name": "Syracuse University"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Syracuse",
        "addressRegion": "NY",
        "addressCountry": "US"
      },
      "url": "https://omarmohammed.co",
      "sameAs": [
        "https://linkedin.com/in/ofmohammed",
        "https://github.com/ofmohamm"
      ]
    })} />
  </head>
  <body class="min-h-screen flex flex-col">
    <!--
      Reliability: scroll-reveal sections start hidden and are shown by an
      IntersectionObserver. If JavaScript never runs, this makes them visible
      instead of leaving the page permanently blank below the hero.
    -->
    <noscript>
      <style>
        .reveal { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>

    <!-- Grain texture overlay -->
    <div class="grain-overlay" aria-hidden="true"></div>

    <!-- Skip link -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Header with navigation -->
    <Header />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
