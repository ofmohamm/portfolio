---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Hashed URLs for the two self-hosted font subsets, so they can be preloaded.
// @font-face declarations live in global.css.
import newsreaderUrl from '../assets/fonts/newsreader-latin.woff2?url';
import schibstedUrl from '../assets/fonts/schibsted-grotesk-latin.woff2?url';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Optional above-the-fold image to preload (already-optimized URL). */
  preloadImage?: string;
}

const {
  title,
  preloadImage,
  description = "Electrical engineering student at Syracuse University working in firmware engineering and embedded systems. Edge AI, embedded ML, PCB design, C/C++.",
  image = "/og-image.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://omarmohammed.co');
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <!-- Drops the no-js class immediately so CSS can target the no-JS case.
         Inline and ~60 bytes; no network cost. -->
    <script is:inline>document.documentElement.classList.remove('no-js')</script>
    <!-- Page transitions: morph only the one project photo that pairs with
         where the reader is going (or coming from), and only if it is on
         screen. Otherwise other cards' photos would fade out as loose layers,
         and going back from the bottom of a long page would fly the cover in
         from far above the viewport. Landing back on a card, its title fades
         in as the photo arrives rather than snapping on afterwards. -->
    <script is:inline>(function(){function fit(e,url){if(!e.viewTransition)return;var path=url?new URL(url).pathname:null;var els=document.querySelectorAll('[data-vt]');for(var i=0;i<els.length;i++){var el=els[i],r=el.getBoundingClientRect(),id=el.getAttribute('data-vt').slice(6);var pairs=!path||path==='/'||path.indexOf('/projects/'+id+'/')===0;var keep=pairs&&r.width>0&&r.bottom>0&&r.top<innerHeight;el.style.viewTransitionName=keep?'cover-'+id:'none';var card=keep&&e.type==='pagereveal'&&el.closest('.project-card');if(card){card.classList.remove('vt-landing');void card.offsetWidth;card.classList.add('vt-landing');setTimeout(function(){card.classList.remove('vt-landing')},900)}}}addEventListener('pageswap',function(e){fit(e,e.activation&&e.activation.entry&&e.activation.entry.url)});addEventListener('pagereveal',function(e){var a=window.navigation&&navigation.activation;fit(e,a&&a.from&&a.from.url)})})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!--
      Favicons. /favicon.ico matters specifically because browsers and Google
      request that path automatically whether or not it is declared, and it was
      previously still Astro's default logo.
    -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!--
      /llms.txt v2 link relations: point agents at the markdown twin of this
      page and at the llms.txt that describes it.
    -->
    <link rel="alternate" type="text/markdown" href="/index.md" />
    <link rel="describedby" href="/llms.txt" />

    <!--
      Fonts are self-hosted (see global.css). No third-party origin, no
      render-blocking stylesheet from fonts.googleapis.com.
    -->
    <link rel="preload" href={newsreaderUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={schibstedUrl} as="font" type="font/woff2" crossorigin />

    <!-- Above-the-fold image paints first; start it before the parser gets there. -->
    {preloadImage && <link rel="preload" href={preloadImage} as="image" />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Omar Mohammed",
      "jobTitle": "Electrical Engineering Student",
      "description": "Electrical engineering student focused on firmware engineering and embedded systems.",
      "knowsAbout": ["Firmware Development", "Embedded Systems", "Edge AI", "Machine Learning", "Power Measurement", "Register-Level Programming", "Bare-Metal Firmware", "STM32", "ATSAMD21", "VHDL", "RTL Design", "PCB Design", "KiCad", "C", "C++", "Python", "MATLAB"],
      "affiliation": {
        "@type": "CollegeOrUniversity",
        "name": "Syracuse University",
        "sameAs": "https://www.syracuse.edu"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Syracuse",
        "addressRegion": "NY",
        "addressCountry": "US"
      },
      "worksFor": {
        "@type": "Organization",
        "name": "Flox Intelligence"
      },
      "url": "https://omarmohammed.co",
      "sameAs": [
        "https://www.linkedin.com/in/ofmohammed",
        "https://github.com/ofmohamm"
      ]
    })} />
  </head>
  <body class="min-h-screen flex flex-col">
    <!--
      Reliability: scroll-reveal sections start hidden and are shown by an
      IntersectionObserver. If JavaScript never runs, this makes them visible
      instead of leaving the page permanently blank below the hero.
    -->
    <noscript>
      <style>
        .reveal { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>

    <!-- Grain texture overlay -->
    <div class="grain-overlay" aria-hidden="true"></div>

    <!-- Skip link -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Header with navigation -->
    <Header />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
